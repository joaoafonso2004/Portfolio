---
  // Images replaced by compressed videos
  const media = [
    '/work/pizzaria.mp4',
    '/work/3DWebsite.mp4',
    '/work/Siroco.mp4',
    '/work/RedBull.mp4',
    '/work/LIMINAL.mp4'
  ];

const capabilities = [
  {
    title: 'Product Design & UX',
    description:
      'Research, user flows, information architecture and the screens themselves. I design in the browser as often as in Figma, so what gets specced is what can actually be built.',
  },
  {
    title: 'Front End & Motion',
    description:
      'Astro, React and Three.js. Scroll-driven interfaces and WebGL when the idea calls for it — animated where it earns the frame, never where it only costs one.',
  },
  {
    title: 'Back End & Data',
    description:
      'APIs, auth, databases and the scheduled jobs that keep them current. Supabase and serverless functions, plus the scrapers and pipelines that gather whatever a product needs to be useful.',
  },
  {
    title: 'Apps & Distribution',
    description:
      'iOS and Windows builds with Expo and Electron — code signing, over-the-air installs, and a release pipeline that updates this site on its own the moment a version ships.',
  },
  {
    title: 'Brand & Art Direction',
    description:
      'Type, colour, imagery and the rules that bind them — enough system that the tenth page still looks like it belongs to the first.',
  },
];

const count = String(capabilities.length).padStart(2, '0');


---

<section id="capabilities" class="section-x section-y relative border-t border-line">
  <div class="shell">
    <!-- Section header -->
    <div class="mb-12 flex items-end justify-between gap-4 md:mb-20">
      <h2
        data-split
        data-hslide="1"
        class="font-display text-[clamp(2.2rem,7vw,6.5rem)] font-semibold uppercase leading-[0.95] tracking-[-0.02em]"
      >
        What<br />I do
      </h2>
      <span class="shrink-0 text-right font-mono text-[10px] uppercase leading-relaxed tracking-[0.16em] text-muted sm:text-[11px] sm:tracking-[0.18em]">
        Capabilities<br class="sm:hidden" /><span class="hidden sm:inline"> — </span>({count})
      </span>
    </div>

    <!-- Rows -->
    <div class="relative" id="capabilities-list">
      {
        capabilities.map((cap, i) => (
          <div
            class="group relative overflow-hidden border-t border-line last:border-b"
            data-reveal
            data-cap-row={i}
          >
            <div class="absolute inset-0 translate-y-full bg-accent transition-transform duration-500 ease-out-expo group-hover:translate-y-0" />
            <div class="relative px-1 py-7 transition-colors duration-300 group-hover:text-ink md:py-10">
              {/* 24px of gap plus the marker leaves ~215px of measure at 320px,
                  which breaks every title onto two cramped lines. */}
              <div class="flex items-baseline gap-3 md:items-center md:gap-10">
                <span class="shrink-0 font-mono text-[10px] tracking-[0.2em] text-accent transition-colors duration-300 group-hover:text-ink md:text-[11px]">
                  ({String(i + 1).padStart(2, '0')})
                </span>
                <h3 class="font-display text-[clamp(1.55rem,7vw,3.6rem)] font-medium uppercase leading-[0.95] tracking-[-0.01em] md:leading-none">
                  {cap.title}
                </h3>
              </div>
              <div class="grid grid-rows-[1fr] transition-[grid-template-rows] duration-500 ease-out-expo md:grid-rows-[0fr] md:group-hover:grid-rows-[1fr]">
                <div class="overflow-hidden">
                  <p class="max-w-2xl pt-3.5 text-[0.9rem] leading-relaxed text-muted transition-colors duration-300 group-hover:text-ink/75 md:pl-16 md:pt-5 md:text-base">
                    {cap.description}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))
      }

      <!-- Floating Media -->
      <div id="cap-floater" class="pointer-events-none fixed left-0 top-0 z-[100] h-64 w-80 -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-xl opacity-0 scale-90 transition-[opacity,transform] duration-500 ease-out-expo will-change-transform hidden md:block bg-ink">
        {media.map((src, i) => (
          <video
            src={src}
            preload="none"
            data-lazy-video
            loop
            muted
            playsinline
            class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300"
            data-cap-media
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (finePointer && !reduced) {
      import('gsap').then(({ gsap }) => {
        const floater = document.getElementById('cap-floater');
        const rows = document.querySelectorAll<HTMLElement>('[data-cap-row]');
        if (!floater || !rows.length) return;

        const xTo = gsap.quickTo(floater, "x", { duration: 0.4, ease: "power3.out" });
        const yTo = gsap.quickTo(floater, "y", { duration: 0.4, ease: "power3.out" });
        const mediaElements = floater.querySelectorAll<HTMLVideoElement>('[data-cap-media]');

        // Só aqui — dentro do ramo `finePointer` — é que os vídeos passam a
        // valer o download. Num telemóvel o floater nunca aparece.
        const capSection = document.getElementById('capabilities');
        if (capSection && 'IntersectionObserver' in window) {
          new IntersectionObserver(([entry]) => {
            mediaElements.forEach(v => {
              if (entry.isIntersecting) {
                if (v.preload !== 'auto') {
                  v.preload = 'auto';
                  v.load();
                }
                v.play().catch(() => {});
              } else {
                v.pause();
              }
            });
          }).observe(capSection);
        }

        let isHovering = false;
        let lastRandom = -1;

        window.addEventListener('mousemove', (e) => {
          if (isHovering) {
            xTo(e.clientX);
            yTo(e.clientY);
          }
        });

        rows.forEach((row) => {
          row.addEventListener('mouseenter', (e) => {
            // Instantly snap to cursor on first enter
            if (!isHovering) {
              xTo(e.clientX);
              yTo(e.clientY);
            }
            isHovering = true;
            
            // Pick a random media that is different from the last one
            let randomIdx;
            if (mediaElements.length > 1) {
              do {
                randomIdx = Math.floor(Math.random() * mediaElements.length);
              } while (randomIdx === lastRandom);
            } else {
              randomIdx = 0;
            }
            lastRandom = randomIdx;

            // Show floater
            floater.style.opacity = '1';
            floater.style.transform = 'translate(-50%, -50%) scale(1) rotate(2deg)';
            
            // Switch media
            mediaElements.forEach((vid, i) => {
              vid.style.opacity = i === randomIdx ? '1' : '0';
            });
          });

          row.addEventListener('mouseleave', () => {
            isHovering = false;
            
            // Hide floater
            floater.style.opacity = '0';
            floater.style.transform = 'translate(-50%, -50%) scale(0.9) rotate(0deg)';
          });
        });
      });
    }
  });
</script>
