---
import type { Project } from '../data/projects';
import type { AppConfig } from '../data/apps';
import { Image } from 'astro:assets';
import AppDownloads from './AppDownloads.astro';
import DuotoneScreen from './DuotoneScreen.astro';
import player from '../assets/images/duotone/player-jetlag.jpg';
import playerMeh from '../assets/images/duotone/player-meh.jpg';
import liked from '../assets/images/duotone/liked.jpg';
import playlists from '../assets/images/duotone/playlists.jpg';
import artists from '../assets/images/duotone/artists.jpg';
import artist from '../assets/images/duotone/artist.jpg';
import social from '../assets/images/duotone/social.jpg';
import profile from '../assets/images/duotone/profile.jpg';
import equalizer from '../assets/images/duotone/equalizer.webp';
import windowsLibrary from '../assets/images/duotone/windows-library.png';
import windowsPlayer from '../assets/images/duotone/windows-player.png';
import logo from '../assets/images/duotone/logo.png';

interface Props { project: Project; app?: AppConfig; }
const { project, app } = Astro.props;
const screens = [
  { id: 'playlists', label: 'Playlists', image: playlists, title: 'Your mixes.', text: 'Keep your favourite tracks together.', alt: 'Duotone iOS playlist library with a two-column grid of cover artwork' },
  { id: 'songs', label: 'Liked songs', image: liked, title: 'On repeat.', text: 'Save, search and shuffle your favourites.', alt: 'Duotone iOS liked songs with play, shuffle and sorting controls' },
  { id: 'artists', label: 'Artists', image: artists, title: 'Your rotation.', text: 'Find favourites and your most-played artists.', alt: 'Duotone iOS artists view with on-repeat artists and favourites' },
  { id: 'artist', label: 'Artist detail', image: artist, title: 'More to discover.', text: 'Songs, albums and new releases in one place.', alt: 'Duotone iOS artist page with a portrait, latest release and saved songs' },
  { id: 'profile', label: 'Your profile', image: profile, title: 'Your taste.', text: 'Feature a song, share playlists and see your listening stats.', alt: 'Duotone iOS personal profile with a cover photo, featured song, playlists and listening overview' },
  { id: 'social', label: 'Friends', image: social, title: 'Better together.', text: 'Friends and conversations, alongside your music.', alt: 'Duotone iOS social screen with friends, activity and group conversations' },
];
---

<article class="duotone-case">
  <div class="case-topline">
    <a href="/#work" class="quiet-link">← All work</a>
    <span class="micro">Independent music app</span>
  </div>

  <header class="duo-hero" id="hero">
    <div class="hero-copy">
      <p class="micro hero-kicker"><Image class="duo-mark" src={logo} width={44} height={44} alt="" aria-hidden="true" /> iOS & Windows</p>
      <h1>Duotone<span class="title-dot">.</span></h1>
      <p class="hero-statement">Your music.<br /><em>A little closer.</em></p>
      <div class="hero-actions">
        <a href="#duotone-experience" class="duo-button primary">Explore the app <span aria-hidden="true">↘</span></a>
        <a href="#duotone-download" class="quiet-link">Get Duotone <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero-stage" data-morph-target>
      <div class="stage-orbit orbit-one" aria-hidden="true"></div>
      <div class="stage-orbit orbit-two" aria-hidden="true"></div>
      <div class="hero-phone rear"><DuotoneScreen src={playerMeh} alt="Duotone player with teal artwork and playback controls" eager /></div>
      <div class="hero-phone front"><DuotoneScreen src={player} alt="Duotone player with three-dimensional album artwork and an ambient background" eager /></div>
    </div>
  </header>

  <dl class="project-facts">
    <div><dt>Built with</dt><dd>React Native · Expo · Electron · Supabase</dd></div>
  </dl>

  <section class="player-section" id="duotone-player" aria-labelledby="player-heading">
    <div class="player-showcase">
      <div class="player-note"><p class="micro section-index">01 / Player</p><h2 id="player-heading">Artwork<br /><em>in motion.</em></h2><p>3D covers, lyrics and ambient colour.</p></div>
      <div class="player-demo">
        <figure>
          <div class="video-phone"><video controls autoplay loop muted playsinline preload="auto" poster="/work/duotone/artwork-poster.jpg" aria-label="iOS screen recording demonstrating the Duotone three-dimensional artwork player"><source src="/work/duotone/artwork-demo.mp4" type="video/mp4" />Your browser does not support this video. <a href="/work/duotone/artwork-demo.mp4">Download the player recording</a>.</video></div>
          <figcaption>iOS recording <span class="duration">00:09</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="equalizer-section" id="duotone-equalizer" aria-labelledby="equalizer-heading">
    <div class="equalizer-showcase">
      <div class="equalizer-visual"><div class="equalizer-phone"><DuotoneScreen src={equalizer} alt="Duotone iOS equalizer with playback speed, six presets, ten sound bands and per-track settings synced between devices" /></div></div>
      <div class="equalizer-copy">
        <p class="micro section-index">02 / Equalizer</p>
        <h2 id="equalizer-heading">Make it<br /><em>your sound.</em></h2>
        <ul class="sound-features">
          <li>10 bands · 6 presets</li>
          <li>Adjustable playback speed</li>
          <li>Per-track settings, synced across devices</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="experience-section" id="duotone-experience" aria-labelledby="experience-heading">
    <div class="section-heading">
      <p class="micro section-index">03 / Explore iOS</p>
      <h2 id="experience-heading">Your library.<br /><em>Your people.</em></h2>
    </div>
    <div class="experience-tabs" role="tablist" aria-label="Explore Duotone screens" data-duotone-tabs>
      {screens.map((screen, i) => <button type="button" role="tab" id={`tab-${screen.id}`} aria-controls={`panel-${screen.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{screen.label}</button>)}
    </div>
    <div class="experience-panels">
      {screens.map((screen, i) => (
        <div class="experience-panel" role="tabpanel" id={`panel-${screen.id}`} aria-labelledby={`tab-${screen.id}`} hidden={i !== 0} tabindex="0">
          <div class="tour-copy"><span class="tour-number" aria-hidden="true">0{i + 1}<span>/ 06</span></span><h3>{screen.title}</h3><p>{screen.text}</p></div>
          <div class={`tour-visual visual-${screen.id}`}><span class="visual-word" aria-hidden="true">{screen.label}</span><div class="tour-phone"><DuotoneScreen src={screen.image} alt={screen.alt} /></div></div>
        </div>
      ))}
    </div>
  </section>

  <section class="desktop-section" id="duotone-desktop" aria-labelledby="desktop-heading">
    <div class="section-heading">
      <p class="micro section-index">04 / Windows</p>
      <h2 id="desktop-heading">Same music.<br /><em>More room.</em></h2>
    </div>
    <div class="desktop-gallery">
      <figure>
        <DuotoneScreen src={windowsLibrary} variant="desktop" alt="Duotone Windows liked songs library with sidebar navigation, searchable tracks and persistent playback controls" />
        <figcaption><span class="micro">Library</span></figcaption>
      </figure>
      <figure>
        <DuotoneScreen src={windowsPlayer} variant="desktop" alt="Duotone Windows player with large album artwork, an up-next queue and playback controls" />
        <figcaption><span class="micro">Now playing</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="download-section" id="duotone-download" aria-labelledby="download-heading">
    <div><p class="micro">05 / Download</p><h2 id="download-heading">Get <em>Duotone.</em></h2></div>
    <div class="download-actions">{app && <AppDownloads app={app} />}<a class="source-link" href={project.github} target="_blank" rel="noopener noreferrer">Source on GitHub <span aria-hidden="true">↗</span></a></div>
  </section>

  <dialog class="screenshot-dialog" aria-label="Duotone screenshot" data-duotone-dialog data-lenis-prevent>
    <div class="dialog-toolbar"><p data-duotone-caption></p><button type="button" data-duotone-close aria-label="Close screenshot">✕</button></div>
    <div class="dialog-image-wrap"><img data-duotone-fullscreen alt="" /></div>
  </dialog>
</article>

<style>
  .duotone-case { --duo-lilac: #c4b5df; --duo-dim: #a2a1ab; color: #f2efe8; padding-bottom: 100px; }
  .micro { font-family: 'JetBrains Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .15em; line-height: 1.7; }
  .case-topline { display: flex; align-items: center; justify-content: space-between; gap: 24px; color: var(--duo-dim); }
  .quiet-link { display: inline-flex; align-items: center; justify-content: center; gap: 18px; min-height: 44px; font-family: 'JetBrains Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; transition: color .2s; }
  .quiet-link:hover, .source-link:hover { color: var(--duo-lilac); }
  .duo-hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 20px; padding: 42px 0 60px; }
  .hero-copy { position: relative; z-index: 2; }
  .hero-kicker { display: flex; align-items: center; gap: 12px; color: var(--duo-lilac); margin-bottom: 22px; }
  .duo-mark { display: block; width: 44px; height: 44px; flex-shrink: 0; object-fit: contain; }
  h1 { font-family: 'Clash Display', sans-serif; font-size: clamp(72px, 9vw, 126px); font-weight: 500; line-height: 1; letter-spacing: -.065em; margin-left: -5px; }
  .title-dot { color: var(--duo-lilac); }
  .hero-statement { font-size: clamp(35px, 4vw, 54px); font-weight: 500; line-height: 1.08; letter-spacing: -.035em; margin: 30px 0 22px; }
  em { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; color: var(--duo-lilac); }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; margin-top: 30px; }
  .duo-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 25px; min-height: 50px; padding: 16px 24px; border-radius: 30px; font-size: 12px; font-weight: 700; transition: background .2s, transform .2s; }
  .primary { color: #17131e; background: #d0c1e7; }
  .primary:hover { background: #e5d9f8; transform: translateY(-2px); }
  .hero-stage { position: relative; isolation: isolate; overflow: clip; min-width: 0; height: 650px; background: radial-gradient(ellipse at 55% 50%, #4a354d44, transparent 67%); }
  .stage-orbit { position: absolute; z-index: -1; border: 1px solid #b5a1cf15; border-radius: 50%; width: 110%; height: 78%; left: -3%; top: 11%; transform: rotate(-30deg); }
  .orbit-two { width: 89%; height: 100%; left: 10%; top: 0; transform: rotate(35deg); }
  .hero-phone { position: absolute; width: 47%; max-width: 274px; }
  .hero-phone.front { top: 60px; right: 4%; transform: rotate(7deg); z-index: 2; }
  .hero-phone.rear { left: 4%; top: 12px; transform: rotate(-9deg); }
  .project-facts { border-block: 1px solid #ffffff20; padding: 22px 0; }
  .project-facts > div { display: flex; align-items: baseline; gap: 24px; }
  .project-facts dt { font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: .13em; font-size: 9px; color: var(--duo-dim); flex-shrink: 0; }
  .project-facts dd { font-size: 12px; line-height: 1.8; }
  section { scroll-margin-top: 100px; }
  .player-section, .experience-section, .equalizer-section, .desktop-section { padding-top: 110px; }
  .section-heading { display: grid; grid-template-columns: 1fr 2fr; gap: 30px; margin-bottom: 45px; }
  .section-index { color: var(--duo-lilac); padding-top: 10px; }
  h2 { font-size: clamp(40px, 5.1vw, 65px); font-weight: 500; letter-spacing: -.045em; line-height: 1.04; }
  .player-showcase { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 50px; padding: 60px; border: 1px solid #ffffff14; border-radius: 24px; background: radial-gradient(ellipse at 85% 25%, #4933464d, transparent 65%), #111115; }
  .player-note h2 { margin-top: 24px; }
  .player-note p:not(.micro) { font-size: 14px; line-height: 1.8; color: var(--duo-dim); margin-top: 24px; max-width: 280px; }
  .player-demo { width: min(100%, 280px); justify-self: center; min-width: 0; }
  .video-phone { padding: 5px; border: 1px solid #64616c; background: #17171c; border-radius: 29px; overflow: hidden; box-shadow: 0 20px 35px #0005; }
  .video-phone video { display: block; width: 100%; height: auto; aspect-ratio: 576 / 1248; border-radius: 23px; background: #09090d; }
  figcaption { display: flex; gap: 9px; align-items: baseline; font-size: 10px; line-height: 1.7; margin-top: 18px; }
  figcaption > span { font-family: 'JetBrains Mono', monospace; color: var(--duo-dim); font-size: 9px; }
  .duration { margin-left: auto; }
  .equalizer-showcase { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid #ffffff18; border-radius: 24px; overflow: hidden; background: #111115; }
  .equalizer-visual { display: grid; place-items: center; padding: 45px; background: radial-gradient(ellipse at 50% 40%, #55416077, #211e2966); }
  .equalizer-phone { width: 270px; max-width: 100%; }
  .equalizer-copy { align-self: center; padding: 50px; }
  .equalizer-copy h2 { margin-top: 24px; }
  .sound-features { margin-top: 30px; list-style: none; padding: 0; }
  .sound-features li { padding-block: 16px; border-top: 1px solid #ffffff1a; color: var(--duo-dim); font-size: 13px; line-height: 1.6; }
  .desktop-gallery { display: grid; gap: 60px; }
  .desktop-gallery figcaption { margin-top: 16px; }
  .desktop-gallery .micro { color: var(--duo-lilac); }
  .experience-tabs { display: flex; gap: 8px; flex-wrap: wrap; padding-bottom: 24px; }
  .experience-tabs button { min-height: 44px; padding: 11px 20px; border: 1px solid #ffffff25; border-radius: 30px; color: #b3b0bc; font-size: 12px; transition: background .2s, color .2s; }
  .experience-tabs button:hover { border-color: var(--duo-lilac); color: white; }
  .experience-tabs button[aria-selected='true'] { background: #d0c1e7; color: #17131e; border-color: #d0c1e7; }
  .experience-panels { border: 1px solid #ffffff18; border-radius: 24px; overflow: hidden; background: #111115; }
  .experience-panel { display: grid; grid-template-columns: 1fr 1fr; min-height: 690px; }
  .experience-panel[hidden] { display: none; }
  .tour-copy { padding: 60px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .tour-number { color: var(--duo-lilac); font-family: 'JetBrains Mono', monospace; font-size: 14px; margin-bottom: 36px; }
  .tour-number > span { color: #74717d; font-size: 10px; margin-left: 8px; }
  .tour-copy h3 { font-size: clamp(30px, 3vw, 42px); letter-spacing: -.04em; line-height: 1.1; max-width: 340px; }
  .tour-copy > p { color: #aaa7b1; font-size: 14px; line-height: 1.9; margin-top: 24px; max-width: 350px; }
  .tour-visual { position: relative; display: grid; place-items: center; overflow: hidden; padding: 44px; background: radial-gradient(ellipse at 50% 40%, #55416077, #211e2966); }
  .visual-word { position: absolute; transform: rotate(-90deg); color: #bca7da10; font-family: 'Clash Display', sans-serif; font-weight: 600; font-size: 115px; white-space: nowrap; }
  .tour-phone { position: relative; width: 270px; max-width: 100%; }
  .download-section { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 100px; padding: 75px 0 0; margin-top: 110px; border-top: 1px solid #ffffff20; }
  .download-section .micro { margin-bottom: 28px; color: var(--duo-lilac); }
  .download-actions { width: 100%; max-width: 420px; justify-self: end; }
  .source-link { display: flex; align-items: center; justify-content: space-between; min-height: 44px; font-size: 12px; border-bottom: 1px solid #ffffff25; padding: 15px 0; margin-top: 14px; transition: color .2s; }
  .screenshot-dialog { position: fixed; inset: 0; width: min(900px, 96vw); height: 94dvh; max-height: 94dvh; max-width: 96vw; margin: auto; padding: 0; background: #111115; color: #f2efe8; border: 1px solid #ffffff30; border-radius: 18px; overflow: hidden; }
  .screenshot-dialog::backdrop { background: #060609ed; }
  .dialog-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 10px 18px; border-bottom: 1px solid #ffffff20; height: 72px; }
  .dialog-toolbar p { font-size: 12px; line-height: 1.5; color: #bdb8c7; }
  .dialog-toolbar button { flex-shrink: 0; min-width: 44px; min-height: 44px; border-radius: 50%; border: 1px solid #ffffff30; }
  .dialog-toolbar button:hover { background: #ffffff20; }
  .dialog-image-wrap { height: calc(100% - 72px); overflow: auto; padding: 16px; overscroll-behavior: contain; }
  .dialog-image-wrap img { display: block; max-width: 100%; width: auto; height: 100%; margin: auto; object-fit: contain; }
  .screenshot-dialog[data-layout='desktop'] { width: min(1440px, 96vw); height: fit-content; }
  .screenshot-dialog[data-layout='desktop'] .dialog-image-wrap { height: auto; max-height: calc(94dvh - 72px); }
  .screenshot-dialog[data-layout='desktop'] img { width: 100%; height: auto; }
  @media (min-width: 1400px) { .hero-stage { height: 680px; } }
  @media (max-width: 1023px) {
    .duo-hero { gap: 12px; } h1 { font-size: 90px; } .hero-stage { height: 545px; } .hero-phone { width: 49%; } .hero-phone.front { right: 0; top: 90px; } .hero-phone.rear { left: 0; top: 40px; }
    .hero-statement { font-size: 42px; }
    .player-showcase { padding: 35px; gap: 28px; }
    .equalizer-copy { padding: 30px; } .equalizer-visual { padding: 30px; }
    .tour-copy { padding: 35px; } .tour-visual { padding: 32px; } .experience-panel { min-height: 650px; }
    .download-section { gap: 45px; }
  }
  @media (max-width: 767px) {
    .duotone-case { padding-bottom: 65px; } .case-topline > .micro { font-size: 8px; letter-spacing: .05em; text-align: right; max-width: 135px; }
    .duo-hero { grid-template-columns: 1fr; padding-top: 30px; padding-bottom: 30px; gap: 40px; }
    h1 { font-size: clamp(78px, 17vw, 120px); } .hero-kicker { font-size: 9px; margin-bottom: 20px; }
    .hero-statement { font-size: 43px; margin-top: 22px; }
    .hero-actions { margin-top: 25px; gap: 20px; }
    .hero-stage { height: auto; aspect-ratio: .9; width: 100%; max-width: 500px; justify-self: center; }
    .hero-phone { width: 45%; } .hero-phone.front { right: 8%; top: 9%; } .hero-phone.rear { left: 7%; top: 0; }
    .project-facts { padding: 20px 0; } .project-facts > div { flex-wrap: wrap; gap: 8px 16px; } .project-facts dd { font-size: 11px; }
    .player-section, .experience-section, .equalizer-section, .desktop-section { padding-top: 70px; } .section-heading { grid-template-columns: 1fr; gap: 20px; margin-bottom: 30px; }
    h2 { font-size: 47px; }
    .player-showcase { grid-template-columns: 1fr; padding: 28px 20px; gap: 35px; border-radius: 18px; }
    .player-note h2 { margin-top: 20px; } .player-note p:not(.micro) { max-width: 380px; margin-top: 18px; }
    .player-demo { width: min(100%, 255px); } .video-phone { border-radius: 20px; padding: 3px; } .video-phone video { border-radius: 16px; } figcaption { font-size: 9px; flex-wrap: wrap; gap: 5px; } .duration { display: none; }
    .equalizer-showcase { grid-template-columns: 1fr; } .equalizer-copy { grid-row: 1; padding: 30px 25px; } .equalizer-visual { padding: 35px 25px; } .equalizer-phone { width: 255px; }
    .desktop-gallery { gap: 38px; }
    .experience-tabs { gap: 7px; padding-bottom: 20px; } .experience-tabs button { padding: 10px 15px; font-size: 11px; }
    .experience-panel { grid-template-columns: 1fr; min-height: 0; } .tour-copy { padding: 30px 25px; } .tour-number { margin-bottom: 18px; } .tour-copy h3 { font-size: 34px; } .tour-copy > p { margin-top: 16px; }
    .tour-visual { padding: 35px 25px; } .tour-phone { width: 255px; } .visual-word { font-size: 95px; }
    .download-section { grid-template-columns: 1fr; gap: 30px; padding-top: 45px; margin-top: 70px; } .download-actions { max-width: none; }
    .dialog-toolbar { padding-inline: 12px; gap: 10px; } .dialog-toolbar p { font-size: 10px; }
  }
  @media (max-width: 374px) { .hero-actions { gap: 12px; } .duo-button { padding-inline: 19px; } .hero-statement { font-size: 38px; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('.duotone-case');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const controller = new AbortController();
    const { signal } = controller;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus({ preventScroll: true });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i), { signal });
      tab.addEventListener('keydown', (event) => {
        let index = i;
        if (event.key === 'ArrowRight') index = (i + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') index = (i - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') index = 0;
        else if (event.key === 'End') index = tabs.length - 1;
        else return;
        event.preventDefault();
        select(index, true);
      }, { signal });
    });

    const dialog = root.querySelector<HTMLDialogElement>('[data-duotone-dialog]')!;
    const fullImage = dialog.querySelector<HTMLImageElement>('[data-duotone-fullscreen]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-duotone-caption]')!;
    let trigger: HTMLButtonElement | null = null;
    const scrollState = { overflow: '', locked: false };
    const restoreScroll = () => {
      if (!scrollState.locked) return;
      document.body.style.overflow = scrollState.overflow;
      scrollState.locked = false;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-duotone-zoom]').forEach((button) => {
      button.addEventListener('click', () => {
        trigger = button;
        fullImage.src = button.dataset.duotoneZoom!;
        fullImage.alt = button.dataset.caption!;
        caption.textContent = button.dataset.caption!;
        dialog.dataset.layout = button.dataset.screenshotLayout ?? 'phone';
        scrollState.overflow = document.body.style.overflow;
        scrollState.locked = true;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
      }, { signal });
    });
    dialog.querySelector('[data-duotone-close]')?.addEventListener('click', () => dialog.close(), { signal });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); }, { signal });
    dialog.addEventListener('close', () => { restoreScroll(); trigger?.focus({ preventScroll: true }); }, { signal });

    const videos = Array.from(root.querySelectorAll<HTMLVideoElement>('video'));
    videos.forEach((video) => {
      video.muted = true;
      void video.play().catch(() => {});
      video.addEventListener('play', () => videos.forEach((other) => { if (other !== video) other.pause(); }), { signal });
    });
    document.addEventListener('astro:before-swap', () => {
      videos.forEach((video) => video.pause());
      if (dialog.open) dialog.close();
      restoreScroll();
      controller.abort();
    }, { once: true, signal });
  });
</script>
