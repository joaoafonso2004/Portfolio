  @media (max-width: 374px) { .hero-actions { gap: 12px; } .duo-button { padding-inline: 19px; } .hero-statement { font-size: 38px; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('.duotone-case');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    const controller = new AbortController();
    const { signal } = controller;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const entrances = new Set<Animation>();
    const reveal = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        reveal.unobserve(entry.target);
        if (motion.matches) return;
        const animation = entry.target.animate([
          { opacity: .35, transform: 'translateY(24px)' },
          { opacity: 1, transform: 'translateY(0)' },
        ], { duration: 700, easing: 'cubic-bezier(.16, 1, .3, 1)' });
        entrances.add(animation);
        animation.finished.then(() => entrances.delete(animation)).catch(() => {});
      });
    }, { threshold: .08 });
    root.querySelectorAll('.player-showcase, .equalizer-showcase, .section-heading, .connect-section, .artist-showcase, .social-showcase').forEach((element) => reveal.observe(element));
    motion.addEventListener('change', () => { if (motion.matches) entrances.forEach((animation) => animation.cancel()); }, { signal });
    const dialog = root.querySelector<HTMLDialogElement>('[data-duotone-dialog]')!;
    const fullImage = dialog.querySelector<HTMLImageElement>('[data-duotone-fullscreen]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-duotone-caption]')!;
    let trigger: HTMLButtonElement | null = null;
    const scrollState = { overflow: '', locked: false };
    const restoreScroll = () => {
      if (!scrollState.locked) return;
      document.body.style.overflow = scrollState.overflow;
      scrollState.locked = false;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-duotone-zoom]').forEach((button) => {
      button.addEventListener('click', () => {
        trigger = button;
        fullImage.src = button.dataset.duotoneZoom!;
        fullImage.alt = button.dataset.caption!;
        caption.textContent = button.dataset.caption!;
        dialog.dataset.layout = button.dataset.screenshotLayout ?? 'phone';
        scrollState.overflow = document.body.style.overflow;
        scrollState.locked = true;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
      }, { signal });
    });
    dialog.querySelector('[data-duotone-close]')?.addEventListener('click', () => dialog.close(), { signal });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); }, { signal });
    dialog.addEventListener('close', () => { restoreScroll(); trigger?.focus({ preventScroll: true }); }, { signal });

    document.addEventListener('astro:before-swap', () => {
      reveal.disconnect();
      entrances.forEach((animation) => animation.cancel());
      if (dialog.open) dialog.close();
      restoreScroll();
      controller.abort();
    }, { once: true, signal });
  });
</script>
