---
const year = new Date().getFullYear();

const socials = [
  { label: 'GitHub', href: 'https://github.com/joaoafonso2004' },
  { label: 'Instagram', href: 'https://www.instagram.com/joao.afonso31/' },
  { label: 'WhatsApp', href: 'https://wa.me/351968467102' },
];
---

<footer id="contact" class="relative overflow-hidden border-t border-line px-5 pb-10 pt-24 md:px-10 md:pt-36">
  <div class="footer-inner mx-auto max-w-[1600px]">
    <span class="eyebrow" data-reveal>Contact — Let's build something rare</span>

    <a
      href="mailto:joaorsafonsoapple@gmail.com"
      class="group mt-8 block w-fit"
      data-cursor-label="Contact"
      data-magnetic
      data-contact-trigger
    >
      <h2
        data-split
        class="font-display text-[clamp(3.4rem,13vw,12rem)] font-semibold uppercase leading-[0.9] tracking-[-0.02em] transition-colors duration-500 group-hover:text-accent"
      >
        Let's<br />Talk<span class="text-accent transition-colors duration-500 group-hover:text-paper">.</span>
      </h2>
    </a>

    <div
      class="mt-14 flex flex-col justify-between gap-6 border-t border-line pt-8 md:flex-row md:items-center"
      data-reveal
    >
      <a
        href="mailto:joaorsafonsoapple@gmail.com"
        class="btn-pill btn-accent w-fit"
        data-magnetic
        data-contact-trigger
      >
        Send a message
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7m0 0H8m9 0v9" />
        </svg>
      </a>
      <ul class="flex flex-wrap items-center gap-7 font-mono text-[11px] uppercase tracking-[0.18em]">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="nav-link text-muted transition-colors duration-300 hover:text-paper"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 font-mono text-[10px] uppercase tracking-[0.18em] text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© {year} João Afonso — All rights reserved</span>
      <span>Viana do Castelo — <span id="local-time">00:00:00</span></span>
      <a href="#hero" class="w-fit transition-colors duration-300 hover:text-accent">Back to top ↑</a>
    </div>
  </div>
</footer>
