---
import { Image } from 'astro:assets';
import { PROJECTS } from '../data/projects';
---

{/*
  One set of cards, two compositions.

  `orbit:` (>=768px wide AND >=620px tall) keeps the desktop ellipse exactly as
  it was — absolutely positioned cards driven by the ticker below.
  Everything narrower or shorter — phones in both orientations — gets a
  snapping touch rail instead: the ring depends on hover to reveal a project's
  name, and on a phone eight cards on an ellipse land on top of each other.
*/}
<section id="work" class="relative overflow-hidden">
  <div
    data-ring-stage
    class="section-x relative w-full py-[var(--section-y)] orbit:flex orbit:h-[100svh] orbit:items-center orbit:justify-center orbit:overflow-hidden orbit:p-0"
  >
    <!-- Cabeçalho -->
    <div
      class="flex items-end justify-between gap-4 orbit:pointer-events-none orbit:absolute orbit:left-10 orbit:right-10 orbit:top-28 orbit:z-[60] orbit:items-start"
    >
      <h2
        data-split
        class="font-display text-[clamp(2.1rem,9vw,3.6rem)] font-semibold uppercase leading-[0.95] tracking-[-0.02em]"
      >
        Selected<br />Work
      </h2>
      <div class="shrink-0 text-right font-mono text-[11px] uppercase tracking-[0.18em] text-muted">
        <span class="block text-accent">({String(PROJECTS.length).padStart(2, '0')})</span>
        <span>Projects</span>
      </div>
    </div>

    <!-- Centro do anel: mostra o projeto sob o cursor (só no anel) -->
    <div
      class="pointer-events-none absolute inset-0 z-[55] hidden flex-col items-center justify-center text-center orbit:flex"
    >
      <span
        data-ring-title
        class="font-display text-[clamp(1.4rem,3vw,2.6rem)] font-medium uppercase leading-none tracking-[-0.01em] opacity-0 transition-opacity duration-500 ease-out-expo"
      ></span>
      <span
        data-ring-category
        class="mt-3 font-mono text-[10px] uppercase tracking-[0.18em] text-accent opacity-0 transition-opacity duration-500 ease-out-expo"
      ></span>
    </div>

    <!-- Os cartões. Rail por toque; anel posicionado pelo ticker em `orbit:`. -->
    <div
      data-ring
      class="rail mt-9 items-start orbit:absolute orbit:inset-0 orbit:m-0 orbit:block orbit:overflow-visible orbit:p-0 orbit:[&::after]:content-none [&[data-focusing]_[data-ring-item]:not([data-focused])_[data-frame]]:blur-[2px] [&[data-focusing]_[data-ring-item]:not([data-focused])_[data-frame]]:grayscale"
    >
      {
        PROJECTS.map((project, i) => (
          <a
            href={`/work/${project.slug}`}
            class="group block w-[min(78vw,340px)] will-change-transform orbit:absolute orbit:left-1/2 orbit:top-1/2 orbit:w-[var(--ring-w)]"
            style={`--ring-w: ${Math.round(320 * (project.weight ?? 1))}px`}
            data-ring-item
            data-index={i}
            data-title={project.title}
            data-category={project.category}
            data-cursor-label="View"
          >
            <div data-slot class="relative aspect-video">
              <div
                data-frame
                class="absolute inset-0 overflow-hidden rounded-lg bg-coal transition-[filter] duration-500 ease-out-expo orbit:rounded-none"
              >
                <Image
                  src={project.img}
                  alt={`${project.title} — designed and built by João Afonso`}
                  widths={[320, 480, 640, 960]}
                  sizes="(max-width: 767px) 78vw, 22vw"
                  class="h-full w-full object-cover object-top"
                />

                {project.video && (
                  <video
                    data-work-video
                    data-lazy-video
                    src={project.video}
                    preload="none"
                    muted
                    loop
                    playsinline
                    aria-hidden="true"
                    tabindex="-1"
                    class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-out-expo data-[playing]:opacity-100"
                  />
                )}

                <span class="pointer-events-none absolute inset-0 bg-ink/0 transition-colors duration-500 group-hover:bg-ink/10" />
              </div>
            </div>

            {/* O anel revela o título ao passar o rato. Sem rato, o cartão
                tem de dizer o que é por si próprio. */}
            <div class="orbit:hidden">
              <div class="mt-4 flex items-baseline justify-between gap-3">
                <h3 class="font-display text-[1.05rem] font-medium uppercase leading-none tracking-[-0.01em]">
                  {project.title}
                </h3>
                <span class="shrink-0 font-mono text-[10px] tracking-[0.18em] text-muted">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <span class="mt-2 block font-mono text-[10px] uppercase leading-relaxed tracking-[0.16em] text-accent">
                {project.category}
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Indicador de posição (toque) -->
    <div class="mt-9 flex items-center justify-between gap-4 orbit:hidden">
      <div class="rail-dots" data-rail-dots aria-hidden="true">
        {PROJECTS.map(() => <span class="rail-dot" />)}
      </div>
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">
        Swipe
        <span class="ml-1 inline-block text-accent">→</span>
      </span>
    </div>

    <!-- Instrução (anel) -->
    <div class="pointer-events-none absolute bottom-10 left-1/2 z-[60] hidden -translate-x-1/2 orbit:block">
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">
        Scroll to spin
      </span>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { navigate } from 'astro:transitions/client';

  /** Tem de espelhar o screen `ring` do tailwind.config.mjs. */
  const RING_QUERY =
    '(min-width: 768px) and (min-height: 620px) and (hover: hover) and (pointer: fine)';

  let tickId = 0;
  let lenisScrollFn: any = null;
  let teardown: (() => void)[] = [];
  /** Fora do `teardown`: sobrevive a cada remontagem, morre na troca de página. */
  let unbindMedia: (() => void) | null = null;

  const cleanup = () => {
    cancelAnimationFrame(tickId);
    tickId = 0;
    teardown.forEach((fn) => fn());
    teardown = [];
  };

  document.addEventListener('astro:before-swap', () => {
    cleanup();
    unbindMedia?.();
    unbindMedia = null;
  });

  document.addEventListener('astro:page-load', () => {
    const stage = document.querySelector<HTMLElement>('[data-ring-stage]');
    if (!stage) return; // Not on the page with the ring

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const ringMQ = window.matchMedia(RING_QUERY);

    const ring = document.querySelector<HTMLElement>('[data-ring]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-ring-item]')];
    const titleEl = document.querySelector<HTMLElement>('[data-ring-title]');
    const categoryEl = document.querySelector<HTMLElement>('[data-ring-category]');
    if (!ring || !items.length) return;

    const videoOf = (item: HTMLElement) =>
      item.querySelector<HTMLVideoElement>('[data-work-video]');

    const play = (video: HTMLVideoElement) => {
      // preload="none" no HTML: só se paga o vídeo quando ele é mesmo preciso.
      if (video.preload !== 'auto') {
        video.preload = 'auto';
        video.load();
      }
      video.play().catch(() => {});
    };

    items.forEach((item) => {
      const video = videoOf(item);
      video?.addEventListener('playing', () => {
        video.dataset.playing = '';
      });
    });

    const videos = items
      .map(videoOf)
      .filter((v): v is HTMLVideoElement => !!v);

    /* ==================== Rail por toque ==================== */

    const initRail = () => {
      const dots = [...document.querySelectorAll<HTMLElement>('[data-rail-dots] .rail-dot')];
      let raf = 0;
      // Nothing streams until the section is actually on screen — otherwise
      // the first card's showreel starts downloading during page load, four
      // screens above where anyone can see it.
      let stageVisible = !('IntersectionObserver' in window);

      const sync = () => {
        raf = 0;
        // Os cartões encostam à linha de snap (scrollLeft + padding), não ao centro.
        const snapLine = ring.scrollLeft + parseFloat(getComputedStyle(ring).paddingLeft || '0');
        let nearest = 0;
        let best = Infinity;
        items.forEach((item, i) => {
          const d = Math.abs(item.offsetLeft - snapLine);
          if (d < best) {
            best = d;
            nearest = i;
          }
        });
        dots.forEach((dot, i) =>
          i === nearest ? dot.setAttribute('data-active', '') : dot.removeAttribute('data-active')
        );
        // Um vídeo de cada vez: o do cartão centrado. Cinco decoders em
        // paralelo derrubam o scroll num telemóvel.
        items.forEach((item, i) => {
          const video = videoOf(item);
          if (!video) return;
          if (i === nearest && stageVisible && !reduced) play(video);
          else if (!video.paused) video.pause();
        });
      };

      const onScroll = () => {
        if (!raf) raf = requestAnimationFrame(sync);
      };

      ring.addEventListener('scroll', onScroll, { passive: true });
      teardown.push(() => ring.removeEventListener('scroll', onScroll));

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          ([entry]) => {
            stageVisible = entry.isIntersecting;
            sync();
          },
          { threshold: 0.25 }
        );
        io.observe(stage);
        teardown.push(() => io.disconnect());
      }

      // O rail é edge-to-edge: alinhar o primeiro cartão à esquerda, não ao centro.
      ring.scrollLeft = 0;
      sync();
    };

    /* ==================== Anel (rato) ==================== */

    const BASE_SPEED = 0.22;
    const SCROLL_PUSH = 0.0016;
    const RETURN_RATE = 0.6;
    const MAX_SPEED = 1.4;

    let angle = 0;
    let speed = BASE_SPEED;

    const boosts = items.map(() => 0);
    let hovered: HTMLElement | null = null;
    let lastHovered: HTMLElement | null = null;
    let transitioning = false;

    function radii() {
      const w = stage!.clientWidth || window.innerWidth;
      const h = stage!.clientHeight || window.innerHeight;
      return {
        rx: Math.min(Math.max(w * 0.28, 140), 400),
        ry: Math.min(Math.max(h * 0.18, 100), 180),
      };
    }

    function layout() {
      const { rx, ry } = radii();
      const step = (Math.PI * 2) / items.length;

      items.forEach((item, i) => {
        const theta = angle + i * step;
        const x = Math.cos(theta) * rx;
        const y = Math.sin(theta) * ry;

        const depth = (Math.sin(theta) + 1) / 2;
        // Keep scale more consistent front-to-back so overlapping is dense everywhere
        const scale = (0.82 + depth * 0.18) * (1 + boosts[i] * 0.32);

        const isHovered = item === hovered;
        const isLastHovered = item === lastHovered;
        const baseZ = 10 + Math.round(depth * 40);

        item.style.transform = `translate(-50%, -50%) translate(${x}px, ${y}px) scale(${scale})`;

        const baseOpacity = 0.95 + depth * 0.05; // Almost fully solid everywhere
        item.style.opacity = String(baseOpacity + (1 - baseOpacity) * boosts[i]);
        item.style.zIndex = String(
          baseZ + (isHovered ? 100 : isLastHovered ? 80 : Math.round(boosts[i] * 20))
        );
      });
    }

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let inView = true;
    let last = performance.now();
    let lastHitTest = 0;

    function tick(now: number) {
      if (!inView) {
        last = now;
        tickId = requestAnimationFrame(tick);
        return;
      }

      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      if (!transitioning) {
        speed += (BASE_SPEED - speed) * RETURN_RATE * dt;

        // Stationary mouse hit-testing (throttled to 100ms for massive performance gain)
        if (finePointer && now - lastHitTest > 100) {
          lastHitTest = now;
          const hit = document.elementFromPoint(mouseX, mouseY);
          const hitItem = (hit?.closest('[data-ring-item]') as HTMLElement) || null;
          if (hitItem !== hovered) {
            if (hovered) hovered.dispatchEvent(new MouseEvent('mouseleave'));
            if (hitItem) hitItem.dispatchEvent(new MouseEvent('mouseenter'));
          }
        }
      }

      angle += speed * dt;

      items.forEach((item, i) => {
        const target = item === hovered ? 1 : 0;
        boosts[i] += (target - boosts[i]) * Math.min(1, 8 * dt);
      });

      layout();
      tickId = requestAnimationFrame(tick);
    }

    function setCentre(item: HTMLElement | null) {
      if (!titleEl || !categoryEl) return;
      if (item) {
        titleEl.textContent = item.dataset.title ?? '';
        categoryEl.textContent = item.dataset.category ?? '';
        titleEl.style.opacity = '1';
        categoryEl.style.opacity = '1';
      } else {
        titleEl.style.opacity = '0';
        categoryEl.style.opacity = '0';
      }
    }

    const initRing = () => {
      const onMouseMove = (e: MouseEvent) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      };
      window.addEventListener('mousemove', onMouseMove, { passive: true });
      teardown.push(() => window.removeEventListener('mousemove', onMouseMove));

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(([entry]) => (inView = entry.isIntersecting));
        io.observe(stage);
        teardown.push(() => io.disconnect());

        if (!reduced) {
          const videoIO = new IntersectionObserver(
            ([entry]) => videos.forEach((v) => (entry.isIntersecting ? play(v) : v.pause())),
            { threshold: 0.05 }
          );
          videoIO.observe(stage);
          teardown.push(() => videoIO.disconnect());
        }
      } else if (!reduced) {
        videos.forEach(play);
      }

      if (!reduced) {
        tickId = requestAnimationFrame((t) => {
          last = t;
          tick(t);
        });
      } else {
        layout();
      }

      const push = (delta: number) => {
        if (transitioning) return;
        speed = gsap.utils.clamp(-MAX_SPEED, MAX_SPEED, speed + delta * SCROLL_PUSH);
      };

      const lenis = (window as any).__lenis;
      const onWheel = (e: WheelEvent) => push(e.deltaY * 0.1);

      if (lenis?.on) {
        lenisScrollFn = (e: any) => push(e.velocity ?? 0);
        lenis.on('scroll', lenisScrollFn);
        teardown.push(() => {
          lenis.off('scroll', lenisScrollFn);
          lenisScrollFn = null;
        });
      } else {
        window.addEventListener('wheel', onWheel, { passive: true });
        teardown.push(() => window.removeEventListener('wheel', onWheel));
      }

      const onResize = () => layout();
      window.addEventListener('resize', onResize);
      teardown.push(() => window.removeEventListener('resize', onResize));

      if (finePointer && !reduced) {
        items.forEach((item) => {
          const video = videoOf(item);
          const frame = item.querySelector<HTMLElement>('[data-frame]');

          const onEnter = () => {
            if (transitioning) return;
            hovered = item;
            lastHovered = item;
            item.setAttribute('data-focused', '');
            ring.setAttribute('data-focusing', '');
            setCentre(item);
            if (video) play(video);
            if (frame) gsap.to(frame, { scale: 1.05, duration: 0.4, ease: 'power2.out' });
          };
          const onLeave = () => {
            if (transitioning) return;
            hovered = null;
            item.removeAttribute('data-focused');
            ring.removeAttribute('data-focusing');
            setCentre(null);
            if (frame) gsap.to(frame, { scale: 1, duration: 0.4, ease: 'power2.out' });
          };

          item.addEventListener('mouseenter', onEnter);
          item.addEventListener('mouseleave', onLeave);
          teardown.push(() => {
            item.removeEventListener('mouseenter', onEnter);
            item.removeEventListener('mouseleave', onLeave);
          });
        });
      }
    };

    /* ---------- Transição para a página do projeto ---------- */
    items.forEach((item) => {
      item.addEventListener('click', (e) => {
        if (transitioning) return e.preventDefault();
        const href = item.getAttribute('href');
        if (!href) return;
        e.preventDefault();
        transitioning = true;

        if ((window as any).audioCtx?.state === 'running') {
          const ctx = (window as any).audioCtx as AudioContext;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(150, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(40, ctx.currentTime + 0.1);
          gain.gain.setValueAtTime(0.1, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.1);
        }

        if (ringMQ.matches && !reduced) {
          gsap.to(items, {
            scale: 0.85,
            autoAlpha: 0,
            duration: 0.4,
            stagger: { amount: 0.1, from: 'center' },
            ease: 'power3.inOut',
          });
          setTimeout(() => navigate(href), 50);
        } else if (reduced) {
          navigate(href);
        } else {
          // No rail, o cartão tocado é o assunto: só ele sai de cena.
          gsap.to(item, { scale: 0.96, opacity: 0.5, duration: 0.28, ease: 'power2.in' });
          gsap.to(stage, { opacity: 0, duration: 0.36, onComplete: () => navigate(href) });
        }
      });
    });

    /* ---------- Escolher a composição, e refazê-la ao rodar o ecrã ---------- */
    const mount = () => {
      cleanup();
      if (ringMQ.matches) {
        initRing();
      } else {
        // Limpa o que o anel possa ter deixado inline antes de o rail assumir:
        // posição no ticker, e a escala que o hover deixou no frame.
        hovered = null;
        lastHovered = null;
        ring.removeAttribute('data-focusing');
        items.forEach((item) => {
          item.style.transform = '';
          item.style.opacity = '';
          item.style.zIndex = '';
          item.removeAttribute('data-focused');
          const frame = item.querySelector<HTMLElement>('[data-frame]');
          if (frame) frame.style.transform = '';
        });
        initRail();
      }
    };

    mount();
    unbindMedia?.();
    ringMQ.addEventListener('change', mount);
    unbindMedia = () => ringMQ.removeEventListener('change', mount);
  });
</script>
