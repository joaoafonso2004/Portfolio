---
---

<section id="hero" class="relative min-h-svh overflow-hidden">
  <!-- WebGL ink-aurora background -->
  <canvas id="hero-canvas" class="absolute inset-0 h-full w-full"></canvas>
  <!-- Fade canvas into the page below -->
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink/30 via-transparent to-ink"
    aria-hidden="true"
  >
  </div>

  <div
    id="hero-content"
    class="hero-content section-x relative z-10 flex min-h-svh flex-col justify-between pb-[max(1.5rem,var(--safe-b))] pt-[calc(var(--nav-h)+var(--safe-t)+2rem)] md:pb-8 md:pt-36"
  >
    <!-- Availability badge -->
    <div
      class="hero-fade inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.2em] text-muted"
    >
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
      Available for new projects — 2026
    </div>

    <!-- Headline -->
    <div class="py-9 md:py-10">
      <h1
        class="font-display text-[clamp(2.4rem,11.5vw,11rem)] font-semibold uppercase leading-[0.93] tracking-[-0.02em]"
      >
        <span class="hero-line block whitespace-nowrap">You name it</span>
        <span class="hero-line block whitespace-nowrap">I build it<span class="text-accent">*</span></span>
        <span
          class="hero-line block font-serif font-normal normal-case italic tracking-normal text-accent"
        >front to back</span>
      </h1>

      <div class="mt-9 flex flex-col gap-7 md:mt-14 md:flex-row md:items-end md:justify-between">
        <p class="hero-fade max-w-md text-[0.95rem] leading-relaxed text-paper/70 sm:text-base md:text-lg">
          Designer and developer from Viana do Castelo. SaaS, brand sites, mobile
          apps, computer vision and videogames.
        </p>
        <!-- Two pills side by side wrap raggedly under 400px; full width reads
             as a deliberate stack and doubles the target size. -->
        <div class="hero-fade flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
          <a href="#work" class="btn-pill btn-accent" data-magnetic>
            Selected work
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0l6-6m-6 6l-6-6"></path>
            </svg>
          </a>
          <a
            href="mailto:joaorsafonsoapple@gmail.com"
            class="btn-pill btn-ghost"
            data-magnetic
            data-contact-trigger
          >
            Get in touch
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom meta row -->
    <div
      class="hero-fade flex items-center justify-between gap-3 border-t border-line pt-5 font-mono text-[10px] uppercase tracking-[0.16em] text-muted md:tracking-[0.18em] md:text-[11px]"
    >
      <span class="flex items-center gap-2">
        Scroll
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3 w-3 animate-bounce">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0l5-5m-5 5l-5-5"></path>
        </svg>
      </span>
      <span class="hidden sm:block">Viana do Castelo — 41.69°N, 8.83°W</span>
      <span>Design — Front end — Back end</span>
    </div>
  </div>
</section>

<script>
  /* ================= WebGL ink-aurora background ================= */

  let renderer: any = null;
  
  document.addEventListener('astro:before-swap', () => {
    if (renderer) {
      renderer.setAnimationLoop(null);
      renderer.dispose();
      renderer = null;
    }
  });

  document.addEventListener('astro:page-load', () => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // three.js is loaded lazily so the core bundle stays light
    const initWebGL = async (canvas: HTMLCanvasElement) => {
      const THREE = await import('three');
      const vertexShader = /* glsl */ `
        void main() {
          gl_Position = vec4(position, 1.0);
        }
      `;

      const fragmentShader = /* glsl */ `
        precision highp float;

        uniform float uTime;
        uniform vec2 uRes;
        uniform vec2 uMouse;
        uniform float uScrollVelocity;

        // Ashima simplex noise (3D)
        vec3 mod289(vec3 x){ return x - floor(x * (1.0/289.0)) * 289.0; }
        vec4 mod289(vec4 x){ return x - floor(x * (1.0/289.0)) * 289.0; }
        vec4 permute(vec4 x){ return mod289(((x*34.0)+1.0)*x); }
        vec4 taylorInvSqrt(vec4 r){ return 1.79284291400159 - 0.85373472095314 * r; }

        float snoise(vec3 v){
          const vec2 C = vec2(1.0/6.0, 1.0/3.0);
          const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
          vec3 i  = floor(v + dot(v, C.yyy));
          vec3 x0 = v - i + dot(i, C.xxx);
          vec3 g = step(x0.yzx, x0.xyz);
          vec3 l = 1.0 - g;
          vec3 i1 = min(g.xyz, l.zxy);
          vec3 i2 = max(g.xyz, l.zxy);
          vec3 x1 = x0 - i1 + C.xxx;
          vec3 x2 = x0 - i2 + C.yyy;
          vec3 x3 = x0 - D.yyy;
          i = mod289(i);
          vec4 p = permute(permute(permute(
                    i.z + vec4(0.0, i1.z, i2.z, 1.0))
                  + i.y + vec4(0.0, i1.y, i2.y, 1.0))
                  + i.x + vec4(0.0, i1.x, i2.x, 1.0));
          float n_ = 0.142857142857;
          vec3 ns = n_ * D.wyz - D.xzx;
          vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
          vec4 x_ = floor(j * ns.z);
          vec4 y_ = floor(j - 7.0 * x_);
          vec4 x = x_ * ns.x + ns.yyyy;
          vec4 y = y_ * ns.x + ns.yyyy;
          vec4 h = 1.0 - abs(x) - abs(y);
          vec4 b0 = vec4(x.xy, y.xy);
          vec4 b1 = vec4(x.zw, y.zw);
          vec4 s0 = floor(b0) * 2.0 + 1.0;
          vec4 s1 = floor(b1) * 2.0 + 1.0;
          vec4 sh = -step(h, vec4(0.0));
          vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
          vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
          vec3 p0 = vec3(a0.xy, h.x);
          vec3 p1 = vec3(a0.zw, h.y);
          vec3 p2 = vec3(a1.xy, h.z);
          vec3 p3 = vec3(a1.zw, h.w);
          vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2,p2), dot(p3,p3)));
          p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
          vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
          m = m * m;
          return 42.0 * dot(m*m, vec4(dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3)));
        }

        float fbm(vec3 p) {
          float v = 0.0;
          float a = 0.5;
          for (int i = 0; i < 2; i++) {
            v += a * snoise(p);
            p *= 2.05;
            a *= 0.5;
          }
          return v;
        }

        void main() {
          vec2 uv = gl_FragCoord.xy / uRes.xy;
          vec2 p = uv - 0.5;
          p.x *= uRes.x / uRes.y;
          float t = uTime * 0.05 - uScrollVelocity * 0.005;
          vec2 m = uMouse * 0.35;

          // Space distortion based on mouse proximity
          vec2 m_offset = m * exp(-length(p - m) * 2.5) * 0.8;
          p -= m_offset;

          // domain-warped fbm — liquid silk
          vec2 q = vec2(
            fbm(vec3(p * 1.1, t)),
            fbm(vec3(p * 1.1 + vec2(5.2, 1.3), t * 0.9))
          );
          vec2 r = vec2(
            fbm(vec3(p * 1.4 + 1.7 * q + vec2(1.7, 9.2) + m, t * 0.8)),
            fbm(vec3(p * 1.4 + 1.7 * q + vec2(8.3, 2.8), t * 0.6))
          );
          float f = fbm(vec3(p * 1.2 + 2.0 * r, t));
          f = f * 0.5 + 0.5;

          // Obsidian base with a smoky champagne drift. Gold reads brighter
          // than violet at the same value, so every term is pulled back —
          // the point is a black screen that catches light, not a gold one.
          vec3 col    = vec3(0.035, 0.038, 0.047);
          vec3 bronze = vec3(0.17, 0.14, 0.10);
          vec3 champ  = vec3(0.60, 0.50, 0.31);
          vec3 sheen  = vec3(0.86, 0.79, 0.62);

          col = mix(col, bronze, smoothstep(0.3, 0.95, f) * 0.8);
          col += champ * pow(f, 3.5) * 0.22;
          col += sheen * pow(max(q.y * 0.5 + 0.5, 0.0), 4.0) * 0.035;

          // mouse glow
          float d = length(p - m * 1.2);
          col += champ * exp(-d * 3.2) * 0.085;

          // vignette
          col *= 1.0 - dot(p, p) * 0.5;

          // dither to kill banding
          float g = fract(sin(dot(uv * uRes.xy, vec2(12.9898, 78.233))) * 43758.5453);
          col += (g - 0.5) * 0.012;

          gl_FragColor = vec4(col, 1.0);
        }
      `;

      renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: false,
        alpha: false,
        powerPreference: 'high-performance',
      });
      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
      const uniforms = {
        uTime: { value: 0 },
        uRes: { value: new THREE.Vector2(1, 1) },
        uMouse: { value: new THREE.Vector2(0, 0) },
        uScrollVelocity: { value: 0 },
      };
      scene.add(
        new THREE.Mesh(
          new THREE.PlaneGeometry(2, 2),
          new THREE.ShaderMaterial({ vertexShader, fragmentShader, uniforms })
        )
      );

      // The aurora is all low-frequency noise, so rendering it under 1:1 and
      // letting the compositor upscale is free visually and cheap on a phone.
      const compact = window.matchMedia('(max-width: 767px)').matches;
      const setSize = () => {
        const w = canvas.clientWidth || window.innerWidth;
        const h = canvas.clientHeight || window.innerHeight;
        const dpr = Math.min(window.devicePixelRatio || 1, compact ? 0.7 : 1.0);
        renderer.setPixelRatio(dpr);
        renderer.setSize(w, h, false);
        uniforms.uRes.value.set(w * dpr, h * dpr);
      };
      setSize();
      window.addEventListener('resize', setSize);

      let targetX = 0;
      let targetY = 0;
      window.addEventListener(
        'mousemove',
        (e) => {
          targetX = e.clientX / window.innerWidth - 0.5;
          targetY = 0.5 - e.clientY / window.innerHeight;
        },
        { passive: true }
      );

      let inView = true;
      new IntersectionObserver(([entry]) => (inView = entry.isIntersecting)).observe(canvas);

      const startTime = performance.now();
      const render = () => {
        uniforms.uTime.value = (performance.now() - startTime) / 1000;
        uniforms.uMouse.value.x += (targetX - uniforms.uMouse.value.x) * 0.05;
        uniforms.uMouse.value.y += (targetY - uniforms.uMouse.value.y) * 0.05;
        
        const v = (window as any).__lenis?.velocity || 0;
        uniforms.uScrollVelocity.value += (v - uniforms.uScrollVelocity.value) * 0.1;
        
        renderer.render(scene, camera);
      };

      if (reducedMotion) {
        render(); // single static frame
      } else {
        renderer.setAnimationLoop(() => {
          if (inView && !document.hidden) render();
        });
      }
    };

    // A refused WebGL context must not take the hero copy down with it.
    initWebGL(canvas).catch(() => canvas.remove());
  });

  /* ================= Intro timeline (after preloader) ================= */

  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  document.addEventListener('astro:page-load', () => {
    const heroContent = document.getElementById('hero-content');
    if (!heroContent) return; // Only run on homepage

    const startIntro = () => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reducedMotion) return;
      
      document.fonts.ready.then(() => {
        const split = new SplitText('.hero-line', { type: 'chars', mask: 'chars' });
        gsap
          .timeline()
          .from(split.chars, {
            yPercent: 118,
            duration: 1.15,
            ease: 'power4.out',
            stagger: 0.016,
          })
          .from(
            '.hero-fade',
            { y: 26, autoAlpha: 0, duration: 0.9, ease: 'power3.out', stagger: 0.09 },
            '-=0.55'
          );
      });
    };

    if ((window as any).__preloaderComplete) {
      startIntro();
    } else {
      document.addEventListener('preloader:done', startIntro, { once: true });
    }
  });
</script>
