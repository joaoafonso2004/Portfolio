---
import { Image } from 'astro:assets';
import portrait from '../assets/images/profile.jpg';
---

<section id="about" class="relative border-t border-line bg-coal px-5 py-24 md:px-10 md:py-36">
  <div class="mx-auto grid max-w-[1600px] grid-cols-1 gap-14 md:grid-cols-12">
    <!-- Portrait with cursor-reveal effect -->
    <div class="md:col-span-4" data-reveal>
      <div class="md:sticky md:top-28">
        <div id="portrait-fx" class="relative overflow-hidden" data-clip>
          <Image
            id="portrait-img"
            src={portrait}
            alt="Portrait of João Afonso"
            widths={[480, 768]}
            sizes="(max-width: 768px) 100vw, 33vw"
            class="aspect-[3/4] w-full object-cover"
          />
          <canvas
            id="portrait-canvas"
            class="pointer-events-none absolute inset-0 h-full w-full"
            aria-hidden="true"
          >
          </canvas>
        </div>
        <div class="mt-4 flex justify-between font-mono text-[11px] uppercase tracking-[0.18em] text-muted">
          <span>João Afonso</span>
          <span>Viana do Castelo, PT</span>
        </div>
      </div>
    </div>

    <!-- Manifesto -->
    <div class="md:col-span-7 md:col-start-6">
      <span class="eyebrow">João — Designer &amp; Developer</span>

      <p
        data-split
        class="mt-7 font-display text-[clamp(1.6rem,3.2vw,2.9rem)] font-medium leading-[1.15] tracking-[-0.01em]"
      >
        The moment an interface stops being a screen and starts being
        <span class="font-serif italic text-accent">an experience.</span>
      </p>

      <p data-reveal class="mt-9 max-w-xl leading-relaxed text-paper/65">
        For the past five years I've been designing and building digital products — from brand
        concepts to booking platforms — that are fast, intentional and quietly beautiful. I
        believe craft is a feature: the difference between products people use and products
        people love lives in milliseconds, microcopy and motion.
      </p>

      <p data-reveal class="mt-5 max-w-xl leading-relaxed text-paper/65">
        I work end-to-end — from first sketch to shipped pixel — with systems thinking and an
        unreasonable attention to detail.
      </p>

      <!-- Stat -->
      <div class="mt-16 border-t border-line pt-8" data-reveal>
        <span class="block font-display text-5xl font-semibold text-paper md:text-7xl">
          <span data-counter="5" data-counter-pad data-counter-suffix="+">05+</span>
        </span>
        <span class="mt-2 block font-mono text-[10px] uppercase tracking-[0.15em] text-muted md:text-[11px]">
          Years of practice
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  /* Cursor-reveal portrait: hovered areas show a violet duotone version
     of the photo through a soft brush trail that fades out over ~2s. */

  const wrap = document.getElementById('portrait-fx');
  const imgEl = document.getElementById('portrait-img') as HTMLImageElement | null;
  const view = document.getElementById('portrait-canvas') as HTMLCanvasElement | null;
  const reducedFx = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrap && imgEl && view && !reducedFx) {
    const ctx = view.getContext('2d')!;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    let styled: HTMLCanvasElement | null = null;
    let trail: HTMLCanvasElement | null = null;
    let tctx: CanvasRenderingContext2D | null = null;
    let raf = 0;
    let lastMove = 0;
    let last: { x: number; y: number } | null = null;

    const drawCover = (c: CanvasRenderingContext2D, w: number, h: number) => {
      const iw = imgEl.naturalWidth;
      const ih = imgEl.naturalHeight;
      if (!iw || !ih) return;
      const s = Math.max(w / iw, h / ih);
      const dw = iw * s;
      const dh = ih * s;
      c.drawImage(imgEl, (w - dw) / 2, (h - dh) / 2, dw, dh);
    };

    const build = () => {
      const w = wrap.clientWidth;
      const h = wrap.clientHeight;
      if (!w || !h) return;
      view.width = w * DPR;
      view.height = h * DPR;

      // pre-render the violet duotone version once
      styled = document.createElement('canvas');
      styled.width = view.width;
      styled.height = view.height;
      const s = styled.getContext('2d')!;
      s.filter = 'grayscale(1) contrast(1.3) brightness(1.05)';
      drawCover(s, styled.width, styled.height);
      s.filter = 'none';
      s.globalCompositeOperation = 'multiply';
      s.fillStyle = '#8C7BFF';
      s.fillRect(0, 0, styled.width, styled.height);
      s.globalCompositeOperation = 'screen';
      s.fillStyle = '#16102E';
      s.fillRect(0, 0, styled.width, styled.height);
      s.globalCompositeOperation = 'source-over';

      // half-res trail mask for performance
      trail = document.createElement('canvas');
      trail.width = Math.max(1, Math.round(view.width / 2));
      trail.height = Math.max(1, Math.round(view.height / 2));
      tctx = trail.getContext('2d')!;
    };

    const stamp = (x: number, y: number) => {
      if (!tctx || !trail) return;
      const r = trail.width * 0.2;
      const g = tctx.createRadialGradient(x, y, 0, x, y, r);
      g.addColorStop(0, 'rgba(255,255,255,1)');
      g.addColorStop(0.5, 'rgba(255,255,255,0.55)');
      g.addColorStop(1, 'rgba(255,255,255,0)');
      tctx.globalCompositeOperation = 'lighter';
      tctx.fillStyle = g;
      tctx.beginPath();
      tctx.arc(x, y, r, 0, Math.PI * 2);
      tctx.fill();
    };

    const tick = () => {
      if (!styled || !trail || !tctx) return;

      // decay the trail (≈2.5s full fade at 60fps)
      tctx.globalCompositeOperation = 'destination-out';
      tctx.fillStyle = 'rgba(0,0,0,0.022)';
      tctx.fillRect(0, 0, trail.width, trail.height);

      // duotone image masked by the trail
      ctx.clearRect(0, 0, view.width, view.height);
      ctx.drawImage(styled, 0, 0);
      ctx.globalCompositeOperation = 'destination-in';
      ctx.drawImage(trail, 0, 0, view.width, view.height);
      ctx.globalCompositeOperation = 'source-over';

      if (performance.now() - lastMove < 3200) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
        ctx.clearRect(0, 0, view.width, view.height);
        tctx.globalCompositeOperation = 'source-over';
        tctx.clearRect(0, 0, trail.width, trail.height);
      }
    };

    const onMove = (e: PointerEvent) => {
      if (!trail) return;
      const rect = wrap.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * trail.width;
      const y = ((e.clientY - rect.top) / rect.height) * trail.height;
      if (last) {
        // interpolate between points for a continuous brush stroke
        const dx = x - last.x;
        const dy = y - last.y;
        const dist = Math.hypot(dx, dy);
        const steps = Math.min(Math.ceil(dist / (trail.width * 0.05)) || 1, 12);
        for (let i = 1; i <= steps; i++) {
          stamp(last.x + (dx * i) / steps, last.y + (dy * i) / steps);
        }
      } else {
        stamp(x, y);
      }
      last = { x, y };
      lastMove = performance.now();
      if (!raf) raf = requestAnimationFrame(tick);
    };

    wrap.addEventListener('pointermove', onMove);
    wrap.addEventListener('pointerleave', () => (last = null));

    const init = () => build();
    if (imgEl.complete && imgEl.naturalWidth) init();
    else imgEl.addEventListener('load', init, { once: true });

    let resizeTimer = 0;
    new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(build, 150);
    }).observe(wrap);
  }
</script>
