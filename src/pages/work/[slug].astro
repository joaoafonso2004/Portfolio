---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { PROJECTS } from '../../data/projects';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Get 3 other random projects for "More to Discover"
const otherProjects = PROJECTS.filter((p) => p.slug !== project.slug)
  .sort(() => 0.5 - Math.random())
  .slice(0, 3);

const isDeviceGallery = project.galleryDevice === true;
const tallHero = project.heroCrop === 'tall';
---

<Layout title={`${project.title} — João Afonso`} description={project.description}>
  <Navbar />

  <main
    class="section-x relative z-10 mx-auto min-h-screen max-w-7xl pb-20 pt-[calc(var(--nav-h)+var(--safe-t)+2.5rem)] md:pt-32"
  >
    <!-- Header -->
    <header class="animate-fade-in mb-12 md:mb-20">
      <a
        href="/#work"
        class="tap mb-7 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-muted transition-colors duration-300 hover:text-accent md:mb-9"
      >
        <span aria-hidden="true">←</span> All work
      </a>

      <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end md:gap-6">
        <div>
          <span class="mb-3 block font-mono text-[10px] uppercase tracking-[0.18em] text-accent md:mb-4">
            {project.category}
          </span>
          <h1
            class="font-display text-[clamp(2.35rem,11vw,5.5rem)] font-semibold uppercase leading-[0.95] tracking-[-0.02em]"
          >
            {project.title}
          </h1>
        </div>

        <div class="flex flex-col gap-6 md:w-1/3">
          <p class="text-[0.95rem] leading-relaxed text-muted sm:text-base">
            {project.description}
          </p>

          {project.stats && project.stats.length > 0 && (
            <div class="my-1 grid grid-cols-3 gap-3 border-y border-white/10 py-5 sm:gap-4 md:my-2 md:py-4">
              {project.stats.map((stat) => (
                <div class="flex flex-col gap-1">
                  <span
                    class="stat-value font-display text-xl font-medium tracking-tight text-paper sm:text-2xl"
                    data-value={stat.value}
                  >
                    0
                  </span>
                  <span class="font-mono text-[9px] uppercase leading-relaxed tracking-[0.14em] text-muted">
                    {stat.label}
                  </span>
                </div>
              ))}
            </div>
          )}

          {/* Full width on a phone: two auto-width pills wrap into a ragged
              stack, and each one ends up under the comfortable touch height. */}
          <div class="mt-1 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
            {project.live && (
              <a
                href={project.live}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex min-h-[2.75rem] items-center justify-center gap-2 rounded-full bg-paper px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.15em] text-ink transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-[0_8px_16px_-6px_rgba(255,255,255,0.15)] sm:w-fit sm:justify-start"
              >
                Visit Live
                <svg class="h-3 w-3 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 13L13 1M13 1H4M13 1V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            )}
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex min-h-[2.75rem] items-center justify-center gap-2 rounded-full border border-paper px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.15em] text-paper transition-all duration-300 hover:-translate-y-1 hover:bg-paper hover:text-ink hover:shadow-[0_8px_16px_-6px_rgba(255,255,255,0.15)] sm:w-fit sm:justify-start"
              >
                GitHub
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12C2 16.418 4.865 19.865 8.839 21.108C9.339 21.2 9.5 20.89 9.5 20.627C9.5 20.395 9.49 19.645 9.485 18.825C6.703 19.429 6.115 17.65 6.115 17.65C5.66 16.495 5.006 16.185 5.006 16.185C4.1 15.565 5.076 15.578 5.076 15.578C6.079 15.648 6.606 16.606 6.606 16.606C7.498 18.136 8.948 17.694 9.537 17.439C9.627 16.772 9.898 16.331 10.198 16.082C7.978 15.829 5.642 14.97 5.642 11.233C5.642 10.169 6.022 9.298 6.643 8.608C6.543 8.355 6.208 7.362 6.738 6.027C6.738 6.027 7.553 5.766 9.494 7.079C10.268 6.864 11.135 6.756 12 6.752C12.864 6.756 13.731 6.864 14.507 7.079C16.446 5.766 17.26 6.027 17.26 6.027C17.792 7.362 17.458 8.355 17.359 8.608C17.981 9.298 18.359 10.169 18.359 11.233C18.359 14.981 16.019 15.825 13.791 16.072C14.167 16.396 14.502 17.034 14.502 18.017C14.502 19.426 14.489 20.564 14.489 20.89C14.489 21.118 14.647 21.433 15.158 21.334C19.13 20.083 22 16.626 22 12.5C22 6.977 17.523 2.5 12 2.5V2Z"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </header>

    {/* Edge to edge on a phone: the gutter costs 40px of a 375px-wide poster
        for no benefit, and the bleed is what makes it read as a hero. */}
    <div
      class:list={[
        'animate-fade-in animation-delay-200 relative mb-16 overflow-hidden bg-coal',
        '-mx-[max(var(--gutter),var(--safe-l))] w-[calc(100%+2*max(var(--gutter),var(--safe-l)))]',
        'sm:mx-0 sm:w-full sm:rounded-lg md:mb-20',
        tallHero ? 'aspect-[4/5] sm:aspect-video' : 'aspect-video',
      ]}
    >
      <Image
        src={project.img}
        alt={project.title}
        widths={[480, 768, 1280, 1600]}
        sizes="(max-width: 767px) 100vw, (max-width: 1280px) 92vw, 1200px"
        class="absolute inset-0 h-full w-full object-cover"
      />
      {project.video && (
        <video
          src={project.video}
          autoplay
          muted
          loop
          playsinline
          class="absolute inset-0 h-full w-full object-cover"
        />
      )}
    </div>

    <!-- Gallery -->
    {project.gallery && project.gallery.length > 0 && (
      <section class="animate-fade-in animation-delay-400 mb-24 md:mb-32">
        <div class="mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Gallery</h2>
          {isDeviceGallery && (
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted md:hidden">
              Swipe <span class="text-accent">→</span>
            </span>
          )}
        </div>

        {isDeviceGallery ? (
          /* Uma rail com molduras no telemóvel, a mesma grelha de sempre no
             desktop. Um único conjunto de imagens: o CSS é que troca de
             composição, por isso nada é descarregado duas vezes. */
          <>
            <div class="rail md:!m-0 md:grid md:grid-cols-3 md:items-start md:gap-10 md:overflow-visible md:!p-0 md:[&::after]:content-none" data-rail="gallery">
              {project.gallery.map((img, index) => (
                <figure class="device group relative w-[min(66vw,270px)] md:w-auto md:overflow-hidden md:rounded-lg md:bg-coal">
                  <div class="device-screen">
                    <Image
                      src={img}
                      alt={`${project.title} — screen ${index + 1} of ${project.gallery.length}`}
                      widths={[320, 480, 640, 900]}
                      sizes="(max-width: 767px) 66vw, 30vw"
                      class="block h-auto w-full transition-all duration-700 md:group-hover:scale-105 md:group-hover:brightness-110"
                    />
                  </div>
                  <div class="pointer-events-none absolute inset-0 hidden bg-paper/5 opacity-0 transition-opacity duration-700 md:block md:group-hover:opacity-100" />
                </figure>
              ))}
            </div>
            <div class="rail-dots mt-7 md:hidden" data-rail-dots="gallery" aria-hidden="true">
              {project.gallery.map(() => <span class="rail-dot" />)}
            </div>
          </>
        ) : (
          <div class={`grid grid-cols-1 gap-4 sm:gap-5 md:gap-10 items-start ${project.galleryLayout === 'grid-3' ? 'md:grid-cols-3' : 'md:grid-cols-2'}`}>
            {project.gallery.map((img, index) => {
              let colSpanClass = '';
              if (project.galleryLayout !== 'grid-3') {
                const isFullWidth = index === 0 || (index === project.gallery.length - 1 && index % 2 !== 0);
                if (isFullWidth) colSpanClass = 'md:col-span-2';
              }
              return (
                <div class={`group relative overflow-hidden rounded-lg bg-coal ${colSpanClass}`}>
                  <Image
                    src={img}
                    alt={`${project.title} gallery image ${index + 1}`}
                    widths={[480, 768, 1200]}
                    sizes="(max-width: 767px) 100vw, 45vw"
                    class="block h-auto w-full transition-all duration-700 group-hover:scale-105 group-hover:brightness-110"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-paper/5 opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>
                </div>
              );
            })}
          </div>
        )}
      </section>
    )}

    <!-- More to Discover -->
    <section class="border-t border-white/10 pb-10 pt-16 md:pt-20">
      <h2 class="mb-9 text-center font-display text-[clamp(1.85rem,7vw,3rem)] font-semibold uppercase leading-none tracking-[-0.01em] md:mb-10">
        More to Discover
      </h2>
      <div class="grid grid-cols-1 gap-7 sm:grid-cols-3 sm:gap-6">
        {otherProjects.map((p) => (
          <a href={`/work/${p.slug}`} class="group block cursor-pointer">
            <div class="relative mb-4 aspect-[16/10] overflow-hidden rounded-lg bg-coal sm:aspect-[4/3]">
              <div class="absolute inset-0 h-full w-full" data-parallax>
                <Image
                  src={p.img}
                  alt={p.title}
                  widths={[320, 480, 768]}
                  sizes="(max-width: 639px) 100vw, 32vw"
                  class="h-full w-full object-cover opacity-80 transition-transform duration-700 group-hover:scale-105 group-hover:opacity-100"
                />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            </div>
            <h3 class="font-display text-lg font-medium uppercase tracking-tight transition-transform duration-500 group-hover:translate-x-2 sm:text-xl">
              {p.title}
            </h3>
            <span class="mt-1 block font-mono text-[10px] uppercase leading-relaxed tracking-[0.15em] text-accent transition-transform delay-75 duration-500 group-hover:translate-x-2">
              {p.category}
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', async () => {
    const stats = document.querySelectorAll('.stat-value');
    if (stats.length === 0) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let liveData = null;
    // Puxa as estatísticas ao vivo da nossa API secreta (apenas se estivermos no projeto LIMINAL ou se a API existir)
    try {
      const res = await fetch('/api/itch');
      if (res.ok) liveData = await res.json();
    } catch (e) {
      // Falha silenciosa, usa os valores por defeito
    }

    stats.forEach((el) => {
      let targetStr = el.getAttribute('data-value') || '0';

      // Override with live data if available
      const labelEl = el.nextElementSibling;
      if (liveData && labelEl) {
        if (labelEl.textContent?.toLowerCase().includes('view')) {
          targetStr = String(liveData.views);
        } else if (labelEl.textContent?.toLowerCase().includes('download')) {
          targetStr = String(liveData.downloads);
        }
      }

      const isK = targetStr.toLowerCase().includes('k');
      let targetNum = parseFloat(targetStr.replace(/[^0-9.]/g, ''));

      if (isNaN(targetNum)) return;
      if (isK) targetNum *= 1000;

      const format = (v: number) => {
        if (isK || v >= 1000) return (v / 1000).toFixed(1).replace('.0', '') + 'k';
        return Math.round(v).toString();
      };

      if (reduced) {
        el.textContent = format(targetNum);
        return;
      }

      const obj = { v: 0 };
      gsap.to(obj, {
        v: targetNum,
        duration: 2.5,
        ease: 'power3.out',
        delay: 0.3,
        onUpdate: () => {
          el.textContent = format(obj.v);
        }
      });
    });
  });
</script>
