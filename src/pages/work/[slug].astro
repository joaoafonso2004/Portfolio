---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { PROJECTS } from '../../data/projects';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Get 3 other random projects for "More to Discover"
const otherProjects = PROJECTS.filter((p) => p.slug !== project.slug)
  .sort(() => 0.5 - Math.random())
  .slice(0, 3);

const isDeviceGallery = project.galleryDevice === true;
const tallHero = project.heroCrop === 'tall';
const inDevelopment = project.status === 'in-development';
---

<Layout title={`${project.title} — João Afonso`} description={project.description}>
  <Navbar />

  <main
    class="section-x relative z-10 mx-auto min-h-screen max-w-7xl pb-20 pt-[calc(var(--nav-h)+var(--safe-t)+2.5rem)] md:pt-32"
  >
    <!-- Header -->
    <header class="animate-fade-in mb-12 md:mb-20">
      <a
        href="/#work"
        class="tap mb-7 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-muted transition-colors duration-300 hover:text-accent md:mb-9"
      >
        <span aria-hidden="true">←</span> All work
      </a>

      <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end md:gap-6">
        <div>
          <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 md:mb-4">
            <span class="block font-mono text-[10px] uppercase tracking-[0.18em] text-accent">
              {project.category}
            </span>
            {inDevelopment && (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-line px-2.5 py-1 font-mono text-[9px] uppercase leading-none tracking-[0.16em] text-paper">
                <span class="h-1 w-1 rounded-full bg-accent" aria-hidden="true" />
                In development
              </span>
            )}
          </div>
          <h1
            class="font-display text-[clamp(2.35rem,11vw,5.5rem)] font-semibold uppercase leading-[0.95] tracking-[-0.02em]"
          >
            {project.title}
          </h1>
        </div>

        <div class="flex flex-col gap-6 md:w-1/3">
          <p class="text-[0.95rem] leading-relaxed text-muted sm:text-base">
            {project.description}
          </p>

          {project.stats && project.stats.length > 0 && (
            <div
              class="my-1 grid grid-cols-3 gap-3 border-y border-white/10 py-5 sm:gap-4 md:my-2 md:py-4"
              data-stats
              data-itch-id={project.itchGameId}
            >
              {project.stats.map((stat) => (
                <div class="flex flex-col gap-1">
                  <span
                    class="stat-value font-display text-xl font-medium tracking-tight text-paper sm:text-2xl"
                    data-value={stat.value}
                    data-live={stat.live}
                  >
                    0
                  </span>
                  <span class="font-mono text-[9px] uppercase leading-relaxed tracking-[0.14em] text-muted">
                    {stat.label}
                  </span>
                </div>
              ))}
            </div>
          )}

          {/* Full width on a phone: two auto-width pills wrap into a ragged
              stack, and each one ends up under the comfortable touch height. */}
          {(project.live || project.github) && (
          <div class="mt-1 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
            {project.live && (
              <a
                href={project.live}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex min-h-[2.75rem] items-center justify-center gap-2 rounded-full bg-paper px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.15em] text-ink transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-[0_8px_16px_-6px_rgba(255,255,255,0.15)] sm:w-fit sm:justify-start"
              >
                Visit Live
                <svg class="h-3 w-3 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 13L13 1M13 1H4M13 1V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            )}
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex min-h-[2.75rem] items-center justify-center gap-2 rounded-full border border-paper px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.15em] text-paper transition-all duration-300 hover:-translate-y-1 hover:bg-paper hover:text-ink hover:shadow-[0_8px_16px_-6px_rgba(255,255,255,0.15)] sm:w-fit sm:justify-start"
              >
                GitHub
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12C2 16.418 4.865 19.865 8.839 21.108C9.339 21.2 9.5 20.89 9.5 20.627C9.5 20.395 9.49 19.645 9.485 18.825C6.703 19.429 6.115 17.65 6.115 17.65C5.66 16.495 5.006 16.185 5.006 16.185C4.1 15.565 5.076 15.578 5.076 15.578C6.079 15.648 6.606 16.606 6.606 16.606C7.498 18.136 8.948 17.694 9.537 17.439C9.627 16.772 9.898 16.331 10.198 16.082C7.978 15.829 5.642 14.97 5.642 11.233C5.642 10.169 6.022 9.298 6.643 8.608C6.543 8.355 6.208 7.362 6.738 6.027C6.738 6.027 7.553 5.766 9.494 7.079C10.268 6.864 11.135 6.756 12 6.752C12.864 6.756 13.731 6.864 14.507 7.079C16.446 5.766 17.26 6.027 17.26 6.027C17.792 7.362 17.458 8.355 17.359 8.608C17.981 9.298 18.359 10.169 18.359 11.233C18.359 14.981 16.019 15.825 13.791 16.072C14.167 16.396 14.502 17.034 14.502 18.017C14.502 19.426 14.489 20.564 14.489 20.89C14.489 21.118 14.647 21.433 15.158 21.334C19.13 20.083 22 16.626 22 12.5C22 6.977 17.523 2.5 12 2.5V2Z"/>
                </svg>
              </a>
            )}
          </div>
          )}
        </div>
      </div>
    </header>

    {/* Edge to edge on a phone: the gutter costs 40px of a 375px-wide poster
        for no benefit, and the bleed is what makes it read as a hero. */}
    <div
      class:list={[
        'animate-fade-in animation-delay-200 relative mb-16 overflow-hidden bg-coal',
        '-mx-[max(var(--gutter),var(--safe-l))] w-[calc(100%+2*max(var(--gutter),var(--safe-l)))]',
        'sm:mx-0 sm:w-full sm:rounded-lg md:mb-20',
        tallHero ? 'aspect-[4/5] sm:aspect-video' : project.poster ? 'aspect-[4/3] sm:aspect-video' : 'aspect-video',
      ]}
    >
      {project.poster && (
        <Image
          src={project.poster}
          alt={project.title}
          widths={[480, 768, 1080]}
          sizes="100vw"
          class="absolute inset-0 h-full w-full object-cover sm:hidden"
        />
      )}
      <Image
        src={project.img}
        alt={project.title}
        widths={[480, 768, 1280, 1600]}
        sizes="(max-width: 767px) 100vw, (max-width: 1280px) 92vw, 1200px"
        class:list={['absolute inset-0 h-full w-full object-cover', project.poster && 'hidden sm:block']}
      />
      {project.video && (
        <video
          src={project.video}
          autoplay
          muted
          loop
          playsinline
          class="absolute inset-0 h-full w-full object-cover"
        />
      )}
    </div>

    {/* Teaser Trailer */}
    {project.trailerVideo && (
      <section class="animate-fade-in animation-delay-300 mb-20 md:mb-28">
        <div class="mb-6 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4">
          <div class="flex items-center gap-2.5">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent animate-pulse" />
            <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Teaser Trailer</h2>
          </div>
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted">20s · Atmospheric Preview</span>
        </div>
        <div class="relative overflow-hidden rounded-lg bg-coal aspect-video border border-white/10 shadow-2xl">
          <video
            src={project.trailerVideo}
            controls
            playsinline
            preload="metadata"
            class="h-full w-full object-cover"
          />
        </div>
      </section>
    )}

    {/* Cinematic Sequence Breakdown (Clips & Stills) */}
    {project.clips && project.clips.length > 0 && (
      <section class="animate-fade-in animation-delay-300 mb-24 md:mb-32">
        <div class="mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4">
          <div>
            <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Sequence Breakdown & Scene Stills</h2>
            <p class="mt-1 text-xs text-muted/70">Hover over any frame to preview motion · Click to expand</p>
          </div>
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-accent">
            {String(project.clips.length).padStart(2, '0')} Scenes
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-7">
          {project.clips.map((clip) => (
            <div
              class="group relative overflow-hidden rounded-lg bg-coal border border-white/10 cursor-pointer transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_12px_24px_-10px_rgba(0,0,0,0.5)]"
              data-clip-item
              data-video-src={clip.video}
              data-img-src={clip.screenshot.src}
              data-title={clip.title}
              tabindex="0"
              role="button"
              aria-label={`View ${clip.title}`}
            >
              <div class="relative aspect-video overflow-hidden bg-ink">
                <Image
                  src={clip.screenshot}
                  alt={clip.title}
                  widths={[380, 640, 960]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <video
                  data-clip-video
                  src={clip.video}
                  preload="none"
                  muted
                  loop
                  playsinline
                  tabindex="-1"
                  aria-hidden="true"
                  class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-out-expo pointer-events-none"
                />
                
                {/* Live hover indicator */}
                <div class="pointer-events-none absolute top-3 right-3 flex items-center gap-1.5 rounded-full bg-ink/75 px-2 py-0.5 font-mono text-[8px] uppercase tracking-[0.14em] text-paper backdrop-blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent animate-ping" />
                  Motion
                </div>
              </div>

              <div class="p-3.5 flex items-center justify-between border-t border-white/5 bg-coal/90">
                <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-paper group-hover:text-accent transition-colors truncate mr-2">
                  {clip.title}
                </span>
                <span class="shrink-0 font-mono text-[9px] uppercase tracking-[0.15em] text-muted">
                  03s
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Sequence Contact Sheet */}
    {project.contactSheet && (
      <section class="animate-fade-in animation-delay-400 mb-24 md:mb-32">
        <div class="mb-6 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4">
          <div>
            <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Sequence Contact Sheet</h2>
            <p class="mt-1 text-xs text-muted/70">Master 12-frame chronological sheet</p>
          </div>
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted">Panoramica</span>
        </div>
        <div
          class="group relative overflow-hidden rounded-lg bg-coal border border-white/10 cursor-pointer"
          data-clip-item
          data-img-src={project.contactSheet.src}
          data-title="Contact Sheet — 12-Frame Sequence"
          tabindex="0"
          role="button"
          aria-label="View Contact Sheet"
        >
          <Image
            src={project.contactSheet}
            alt={`${project.title} — Contact Sheet`}
            widths={[768, 1280, 1920, 2560]}
            sizes="(max-width: 767px) 100vw, 92vw"
            class="block h-auto w-full transition-all duration-700 group-hover:scale-[1.01] group-hover:brightness-105"
          />
          <div class="pointer-events-none absolute inset-0 bg-ink/20 opacity-0 transition-opacity duration-500 group-hover:opacity-100 flex items-end justify-between p-4 sm:p-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-paper bg-ink/80 px-3 py-1.5 rounded-full backdrop-blur-md">
              Click to inspect full resolution
            </span>
          </div>
        </div>
      </section>
    )}

    <!-- Gallery -->
    {project.gallery && project.gallery.length > 0 && (
      <section class="animate-fade-in animation-delay-400 mb-24 md:mb-32">
        <div class="mb-8 flex items-baseline justify-between gap-4 border-b border-white/10 pb-4">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Gallery</h2>
          {isDeviceGallery && (
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted md:hidden">
              Swipe <span class="text-accent">→</span>
            </span>
          )}
        </div>

        {isDeviceGallery ? (
          /* Uma rail com molduras no telemóvel, a mesma grelha de sempre no
             desktop. Um único conjunto de imagens: o CSS é que troca de
             composição, por isso nada é descarregado duas vezes. */
          <>
            <div class="rail md:!m-0 md:grid md:grid-cols-3 md:items-start md:gap-10 md:overflow-visible md:!p-0 md:[&::after]:content-none" data-rail="gallery">
              {project.gallery.map((img, index) => (
                <figure class="device group relative w-[min(66vw,270px)] md:w-auto md:overflow-hidden md:rounded-lg md:bg-coal">
                  <div class="device-screen">
                    <Image
                      src={img}
                      alt={`${project.title} — screen ${index + 1} of ${project.gallery.length}`}
                      widths={[320, 480, 640, 900]}
                      sizes="(max-width: 767px) 66vw, 30vw"
                      class="block h-auto w-full transition-all duration-700 md:group-hover:scale-105 md:group-hover:brightness-110"
                    />
                  </div>
                  <div class="pointer-events-none absolute inset-0 hidden bg-paper/5 opacity-0 transition-opacity duration-700 md:block md:group-hover:opacity-100" />
                </figure>
              ))}
            </div>
            <div class="rail-dots mt-7 md:hidden" data-rail-dots="gallery" aria-hidden="true">
              {project.gallery.map(() => <span class="rail-dot" />)}
            </div>
          </>
        ) : (
          <div class={`grid grid-cols-1 gap-4 sm:gap-5 md:gap-10 items-start ${project.galleryLayout === 'grid-3' ? 'md:grid-cols-3' : 'md:grid-cols-2'}`}>
            {project.gallery.map((img, index) => {
              let colSpanClass = '';
              if (project.galleryLayout !== 'grid-3') {
                const isFullWidth = index === 0 || (index === project.gallery.length - 1 && index % 2 !== 0);
                if (isFullWidth) colSpanClass = 'md:col-span-2';
              }
              return (
                <div class={`group relative overflow-hidden rounded-lg bg-coal ${colSpanClass}`}>
                  <Image
                    src={img}
                    alt={`${project.title} gallery image ${index + 1}`}
                    widths={[480, 768, 1200]}
                    sizes="(max-width: 767px) 100vw, 45vw"
                    class="block h-auto w-full transition-all duration-700 group-hover:scale-105 group-hover:brightness-110"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-paper/5 opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>
                </div>
              );
            })}
          </div>
        )}
      </section>
    )}

    <!-- More to Discover -->
    <section class="border-t border-white/10 pb-10 pt-16 md:pt-20">
      <h2 class="mb-9 text-center font-display text-[clamp(1.85rem,7vw,3rem)] font-semibold uppercase leading-none tracking-[-0.01em] md:mb-10">
        More to Discover
      </h2>
      <div class="grid grid-cols-1 gap-7 sm:grid-cols-3 sm:gap-6">
        {otherProjects.map((p) => (
          <a href={`/work/${p.slug}`} class="group block cursor-pointer">
            <div class="relative mb-4 aspect-[16/10] overflow-hidden rounded-lg bg-coal sm:aspect-[4/3]">
              <div class="absolute inset-0 h-full w-full" data-parallax>
                <Image
                  src={p.poster ?? p.img}
                  alt={p.title}
                  widths={[320, 480, 768]}
                  sizes="(max-width: 639px) 100vw, 32vw"
                  class="h-full w-full object-cover opacity-80 transition-transform duration-700 group-hover:scale-105 group-hover:opacity-100"
                />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            </div>
            <h3 class="font-display text-lg font-medium uppercase tracking-tight transition-transform duration-500 group-hover:translate-x-2 sm:text-xl">
              {p.title}
            </h3>
            <span class="mt-1 block font-mono text-[10px] uppercase leading-relaxed tracking-[0.15em] text-accent transition-transform delay-75 duration-500 group-hover:translate-x-2">
              {p.category}{p.status === 'in-development' && ' · In development'}
            </span>
          </a>
        ))}
      </div>
    </section>
    <!-- Media Lightbox Modal -->
    <div
      id="media-lightbox"
      class="fixed inset-0 z-[100] flex items-center justify-center bg-ink/90 p-4 sm:p-8 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
      role="dialog"
      aria-modal="true"
      aria-label="Media Preview"
    >
      <div class="relative max-h-[90vh] max-w-5xl w-full flex flex-col items-center">
        <button
          id="lightbox-close"
          type="button"
          class="tap mb-3 self-end inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted hover:text-accent transition-colors"
          aria-label="Close modal"
        >
          <span>Close [ESC]</span>
          <span aria-hidden="true">✕</span>
        </button>
        <div
          id="lightbox-media-container"
          class="w-full max-h-[80vh] overflow-hidden rounded-lg bg-coal border border-white/10 shadow-2xl flex items-center justify-center"
        >
          <!-- Dynamic video or img inserted dynamically -->
        </div>
        <p
          id="lightbox-caption"
          class="mt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-paper text-center"
        ></p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from 'gsap';

  /** Formata para o estilo do painel: 912, 1.2k, 3.4k. */
  function format(v: number, forceK: boolean) {
    if (forceK || v >= 1000) return (v / 1000).toFixed(1).replace('.0', '') + 'k';
    return Math.round(v).toString();
  }

  /**
   * Vai buscar as estatísticas ao vivo do itch.io, mas nunca faz a página
   * esperar por elas: ao fim de 2,5 s desiste e deixa entrar os valores
   * escritos à mão. Um itch.io lento deixaria os contadores a zero, que é pior
   * do que um número de ontem.
   */
  async function fetchLive(gameId: string) {
    try {
      const res = await fetch(`/api/itch?id=${encodeURIComponent(gameId)}`, {
        signal: AbortSignal.timeout(2500),
      });
      if (!res.ok) return null;
      const data = await res.json();
      return data && typeof data === 'object' && !data.error ? data : null;
    } catch {
      return null; // Falha em silêncio: os valores manuais chegam.
    }
  }

  function setupMediaHandlers() {
    // Hover-to-play para clips de cena
    const clipItems = document.querySelectorAll<HTMLElement>('[data-clip-item]');
    clipItems.forEach((item) => {
      const video = item.querySelector<HTMLVideoElement>('[data-clip-video]');
      if (!video) return;

      const playVideo = () => {
        video.play().catch(() => {});
        video.classList.remove('opacity-0');
        video.classList.add('opacity-100');
      };

      const pauseVideo = () => {
        video.pause();
        video.currentTime = 0;
        video.classList.remove('opacity-100');
        video.classList.add('opacity-0');
      };

      item.addEventListener('mouseenter', playVideo);
      item.addEventListener('mouseleave', pauseVideo);
      item.addEventListener('focus', playVideo);
      item.addEventListener('blur', pauseVideo);
    });

    // Lightbox modal para clips e screenshots
    const modal = document.getElementById('media-lightbox');
    const container = document.getElementById('lightbox-media-container');
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');

    if (!modal || !container || !caption) return;

    const openLightbox = (imgSrc?: string, videoSrc?: string, title?: string) => {
      container.innerHTML = '';
      if (videoSrc) {
        const vid = document.createElement('video');
        vid.src = videoSrc;
        vid.autoplay = true;
        vid.controls = true;
        vid.loop = true;
        vid.playsInline = true;
        vid.className = 'max-h-[75vh] w-full object-contain';
        container.appendChild(vid);
      } else if (imgSrc) {
        const img = document.createElement('img');
        img.src = imgSrc;
        img.alt = title || '';
        img.className = 'max-h-[75vh] w-auto max-w-full object-contain';
        container.appendChild(img);
      }
      caption.textContent = title || '';
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0', 'pointer-events-none');
      container.innerHTML = '';
      document.body.style.overflow = '';
    };

    clipItems.forEach((item) => {
      const handleClick = (e: Event) => {
        e.preventDefault();
        const videoSrc = item.dataset.videoSrc;
        const imgSrc = item.dataset.imgSrc;
        const title = item.dataset.title;
        openLightbox(imgSrc, videoSrc, title);
      };

      item.addEventListener('click', handleClick);
      item.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          handleClick(e);
        }
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeLightbox);
    }

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeLightbox();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('astro:page-load', async () => {
    setupMediaHandlers();

    const container = document.querySelector<HTMLElement>('[data-stats]');
    if (!container) return;

    const stats = Array.from(container.querySelectorAll<HTMLElement>('.stat-value'));
    if (stats.length === 0) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const gameId = container.dataset.itchId;
    const wantsLive = stats.some((el) => el.dataset.live);
    const live = gameId && wantsLive ? await fetchLive(gameId) : null;

    stats.forEach((el) => {
      // O campo ao vivo ganha ao valor escrito à mão; sem ele, ou sem resposta
      // da API, fica o último valor conhecido.
      const key = el.dataset.live;
      const liveValue = key && live ? live[key] : undefined;
      const targetStr = typeof liveValue === 'number' ? String(liveValue) : el.dataset.value || '0';

      const isK = targetStr.toLowerCase().includes('k');
      let targetNum = parseFloat(targetStr.replace(/[^0-9.]/g, ''));

      if (isNaN(targetNum)) return;
      if (isK) targetNum *= 1000;

      if (reduced) {
        el.textContent = format(targetNum, isK);
        return;
      }

      const obj = { v: 0 };
      gsap.to(obj, {
        v: targetNum,
        duration: 2.5,
        ease: 'power3.out',
        delay: 0.3,
        onUpdate: () => {
          el.textContent = format(obj.v, isK);
        },
      });
    });
  });
</script>
