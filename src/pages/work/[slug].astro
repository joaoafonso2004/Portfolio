---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { PROJECTS } from '../../data/projects';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Get 3 other random projects for "More to Discover"
const otherProjects = PROJECTS.filter((p) => p.slug !== project.slug)
  .sort(() => 0.5 - Math.random())
  .slice(0, 3);
---

<Layout title={`${project.title} — João Afonso`} description={project.description}>
  <Navbar />
  
  <main class="relative z-10 pt-32 pb-20 px-5 md:px-10 max-w-7xl mx-auto min-h-screen">
    <!-- Header -->
    <header class="mb-12 md:mb-20 animate-fade-in">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent mb-4 block">
            {project.category}
          </span>
          <h1 class="font-display text-[clamp(2.5rem,6vw,5.5rem)] font-semibold uppercase leading-[0.95] tracking-[-0.02em]">
            {project.title}
          </h1>
        </div>
        
        <div class="md:w-1/3 flex flex-col gap-6">
          <p class="text-muted text-sm md:text-base leading-relaxed">
            {project.description}
          </p>
          
          {project.stats && project.stats.length > 0 && (
            <div class="grid grid-cols-3 gap-4 py-4 border-y border-white/10 my-2">
              {project.stats.map(stat => (
                <div class="flex flex-col gap-1">
                  <span class="font-display text-2xl font-medium text-paper tracking-tight stat-value" data-value={stat.value}>0</span>
                  <span class="font-mono text-[9px] uppercase tracking-[0.15em] text-muted">{stat.label}</span>
                </div>
              ))}
            </div>
          )}

          <div class="flex flex-wrap gap-4 mt-2">
            {project.live && (
              <a 
                href={project.live} 
                target="_blank" 
                rel="noopener noreferrer"
                class="group inline-flex w-fit items-center gap-2 rounded-full bg-paper px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.15em] text-ink transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_16px_-6px_rgba(255,255,255,0.15)] hover:bg-white"
              >
                Visit Live
                <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 13L13 1M13 1H4M13 1V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            )}
            {project.github && (
              <a 
                href={project.github} 
                target="_blank" 
                rel="noopener noreferrer"
                class="group inline-flex w-fit items-center gap-2 rounded-full border border-paper px-6 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.15em] text-paper transition-all duration-300 hover:-translate-y-1 hover:bg-paper hover:text-ink hover:shadow-[0_8px_16px_-6px_rgba(255,255,255,0.15)]"
              >
                GitHub
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12C2 16.418 4.865 19.865 8.839 21.108C9.339 21.2 9.5 20.89 9.5 20.627C9.5 20.395 9.49 19.645 9.485 18.825C6.703 19.429 6.115 17.65 6.115 17.65C5.66 16.495 5.006 16.185 5.006 16.185C4.1 15.565 5.076 15.578 5.076 15.578C6.079 15.648 6.606 16.606 6.606 16.606C7.498 18.136 8.948 17.694 9.537 17.439C9.627 16.772 9.898 16.331 10.198 16.082C7.978 15.829 5.642 14.97 5.642 11.233C5.642 10.169 6.022 9.298 6.643 8.608C6.543 8.355 6.208 7.362 6.738 6.027C6.738 6.027 7.553 5.766 9.494 7.079C10.268 6.864 11.135 6.756 12 6.752C12.864 6.756 13.731 6.864 14.507 7.079C16.446 5.766 17.26 6.027 17.26 6.027C17.792 7.362 17.458 8.355 17.359 8.608C17.981 9.298 18.359 10.169 18.359 11.233C18.359 14.981 16.019 15.825 13.791 16.072C14.167 16.396 14.502 17.034 14.502 18.017C14.502 19.426 14.489 20.564 14.489 20.89C14.489 21.118 14.647 21.433 15.158 21.334C19.13 20.083 22 16.626 22 12.5C22 6.977 17.523 2.5 12 2.5V2Z"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </header>

    <!-- Hero Media -->
    <div class="relative aspect-video w-full rounded-lg overflow-hidden bg-coal mb-20 animate-fade-in animation-delay-200">
      <Image
        src={project.img}
        alt={project.title}
        class="absolute inset-0 h-full w-full object-cover"
      />
      {project.video && (
        <video
          src={project.video}
          autoplay
          muted
          loop
          playsinline
          class="absolute inset-0 h-full w-full object-cover"
        />
      )}
    </div>

    <!-- Gallery -->
    {project.gallery && project.gallery.length > 0 && (
      <section class="mb-32 animate-fade-in animation-delay-400">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted mb-8 border-b border-white/10 pb-4">Gallery</h2>
        <div class={`grid grid-cols-1 gap-5 md:gap-10 items-start ${project.galleryLayout === 'grid-3' ? 'md:grid-cols-3' : 'md:grid-cols-2'}`}>
          {project.gallery.map((img, index) => {
            let colSpanClass = '';
            if (project.galleryLayout !== 'grid-3') {
              const isFullWidth = index === 0 || (index === project.gallery.length - 1 && index % 2 !== 0);
              if (isFullWidth) colSpanClass = 'md:col-span-2';
            }
            return (
              <div class={`group relative rounded-lg overflow-hidden bg-coal ${colSpanClass}`}>
                <Image
                  src={img}
                  alt={`${project.title} gallery image ${index + 1}`}
                  class="w-full h-auto block transition-all duration-700 group-hover:scale-105 group-hover:brightness-110"
                />
                <div class="pointer-events-none absolute inset-0 bg-paper/5 opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- More to Discover -->
    <section class="border-t border-white/10 pt-20 pb-10">
      <h2 class="font-display text-[clamp(2rem,4vw,3rem)] font-semibold uppercase leading-none tracking-[-0.01em] mb-10 text-center">
        More to Discover
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {otherProjects.map((p) => (
          <a href={`/work/${p.slug}`} class="group block cursor-pointer">
            <div class="relative aspect-[4/3] overflow-hidden rounded-lg bg-coal mb-4">
              <div class="absolute inset-0 h-full w-full" data-parallax>
                <Image
                  src={p.img}
                  alt={p.title}
                  class="h-full w-full object-cover transition-transform duration-700 opacity-80 group-hover:opacity-100 group-hover:scale-105"
                />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            </div>
            <h3 class="font-display text-xl font-medium uppercase tracking-tight transition-transform duration-500 group-hover:translate-x-2">{p.title}</h3>
            <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-accent mt-1 block transition-transform duration-500 delay-75 group-hover:translate-x-2">{p.category}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 0.8s ease-out forwards;
  }
  .animation-delay-200 {
    animation-delay: 0.2s;
  }
  .animation-delay-400 {
    animation-delay: 0.4s;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', async () => {
    const stats = document.querySelectorAll('.stat-value');
    if (stats.length === 0) return;

    let liveData = null;
    // Puxa as estatísticas ao vivo da nossa API secreta (apenas se estivermos no projeto LIMINAL ou se a API existir)
    try {
      const res = await fetch('/api/itch');
      if (res.ok) liveData = await res.json();
    } catch (e) {
      // Falha silenciosa, usa os valores por defeito
    }

    stats.forEach((el) => {
      let targetStr = el.getAttribute('data-value') || '0';
      
      // Override with live data if available
      const labelEl = el.nextElementSibling;
      if (liveData && labelEl) {
        if (labelEl.textContent?.toLowerCase().includes('view')) {
          targetStr = String(liveData.views);
        } else if (labelEl.textContent?.toLowerCase().includes('download')) {
          targetStr = String(liveData.downloads);
        }
      }

      const isK = targetStr.toLowerCase().includes('k');
      let targetNum = parseFloat(targetStr.replace(/[^0-9.]/g, ''));
      
      if (isNaN(targetNum)) return;
      if (isK) targetNum *= 1000;

      const format = (v: number) => {
        if (isK || v >= 1000) return (v / 1000).toFixed(1).replace('.0', '') + 'k';
        return Math.round(v).toString();
      };

      const obj = { v: 0 };
      gsap.to(obj, {
        v: targetNum,
        duration: 2.5,
        ease: 'power3.out',
        delay: 0.3,
        onUpdate: () => {
          el.textContent = format(obj.v);
        }
      });
    });
  });
</script>


